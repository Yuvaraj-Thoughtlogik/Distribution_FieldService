<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template
        id="worksheet_custom_page"
        inherit_id="industry_fsm.worksheet_custom_page"
    >

        <!-- Hide the standard single worksheet -->
        <xpath
            expr="//div[@name='worksheet_signature']/preceding-sibling::t[1]"
            position="attributes"
        >
            <attribute name="t-if">
                doc.worksheet_count and doc.worksheet_template_id.report_view_id and
                worksheet_map.get(doc.id) and not doc.multiple_worksheet
            </attribute>
        </xpath>

        <!-- Add multiple worksheets -->
        <xpath expr="//div[@name='worksheet_signature']" position="before">

            <t t-if="doc.multiple_worksheet and doc.fsm_worksheet_ids">
                <t t-set="completed_fsm_worksheets" t-value="doc.fsm_worksheet_ids.filtered(lambda w: w.state == 'completed')" />
                <h2  style="margin-top: 25px; padding-top: 5px;"  t-if="completed_fsm_worksheets">Worksheets</h2>
                    <t t-foreach="completed_fsm_worksheets" t-as="fsm_worksheet">

                        <div
                            name="worksheets_map"
                            style=" padding-top: 5px;"
                        >
                            <h4 style="margin: 4px 0 2px 0;" t-out="fsm_worksheet.name" />
                            <h6 style="margin: 2px 0 4px 0;" t-if="fsm_worksheet.customer_asset_id"> Customer Asset: <span
                                    t-out="fsm_worksheet.customer_asset_id.display_name" />
                            </h6>
                            <t
                                t-raw="doc.generate_worksheet_html(fsm_worksheet.worksheet_template_id.id, fsm_worksheet.worksheet_id)" />
                            <div style="page-break-after: always;" t-if="not fsm_worksheet_last" />
                        </div>

                    </t>
            </t>

        </xpath>

    </template>

</odoo>