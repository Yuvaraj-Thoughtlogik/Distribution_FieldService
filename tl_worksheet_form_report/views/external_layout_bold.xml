<odoo>
    <template id="external_layout_bold" name="CGUK Bold Layout">
        <div t-attf-class="header o_company_#{company.id}_layout" t-att-style="report_header_style">
            <div class="row o_first_page_letterhead">
                <div class="row">
                    <div class="col-6 text-start">
                        <t t-if="o and 'partner_id' in o._fields">
                            <div t-if="o.partner_id"
                                style="max-height: none !important; height: 180px !important; max-width: none !important; width: 325px !important; padding-top:10px;">
                                <div t-if="o.partner_id.name">
                                    <span t-field="o.partner_id.name" />
                                </div>
                                <div style="width: 500px;">
                                    <span t-field="o.company_name"
                                        t-if="'company_name' in o._fields" />
                                </div>
                                <div style="width: 500px;" t-if="o.partner_id.street">
                                    <span t-field="o.partner_id.street" />
                                </div>
                                <div style="width: 500px;" t-if="o.partner_id.street2">
                                    <span t-field="o.partner_id.street2" />
                                </div>
                                <div style="width: 500px;" t-if="o.partner_id.city">
                                    <span t-field="o.partner_id.city" />
                                </div>
                                <div style="width: 500px;" t-if="o.partner_id.state_id">
                                    <span t-field="o.partner_id.state_id.name" />
                                </div>
                                <div style="width: 500px;" t-if="o.partner_id.zip">
                                    <span t-field="o.partner_id.zip" />
                                </div>
                                <div style="width: 500px;" t-if="o.partner_id.country_id">
                                    <span t-field="o.partner_id.country_id.name" />
                                </div>
                            </div>
                        </t>
                        <br />
                        <t t-if="o and 'client_order_ref' in o._fields">
                            <div t-if="o.client_order_ref" style="margin-top:5px;"
                                class="col d-flex gap-2">
                                <strong class="me-1" style="color: #f1c40f;">Your Reference : </strong>
                                <span t-field="o.client_order_ref" />
                            </div>
                        </t>
                    </div>

                    <div class="col-6 text-end">
                        <div class="mb-4">
                            <img t-if="company.logo" class="o_company_logo_big"
                                t-att-src="image_data_uri(company.logo)" alt="Logo"
                                style="max-height: none !important; height: 180px !important; max-width: none !important; width: 325px !important;" />
                        </div>

                        <div class="text-end"
                            style="width: 330px; display: inline-block; float: right; margin-top: 0; padding: 0; line-height: 0.0;">
                            <t t-if="o and o._name == 'sale.order'">
                                <t t-if="o.user_id.name">
                                    <div name="salesperson"
                                        style="width: 100%; clear: both; display: block; margin-bottom: 4px; line-height: 1.3;">
                                        <div
                                            style="width: 50%; float: left; text-align: right; color: #212529; padding-right: 8px; box-sizing: border-box;">
                                            <strong>SALESPERSON:</strong>
                                        </div>
                                        <div
                                            style="width: 50%; float: left; text-align: left; padding-left: 8px; box-sizing: border-box;">
                                            <span t-field="o.user_id.name" />
                                        </div>
                                    </div>
                                </t>

                                <t t-if="o.date_order">
                                    <div name="informations_date"
                                        style="width: 100%; clear: both; display: block; margin-bottom: 4px; line-height: 1.3;">
                                        <div
                                            style="width: 50%; float: left; text-align: right; color: #212529; padding-right: 8px; box-sizing: border-box;">
                                            <strong t-if="is_proforma">Issued Date</strong>
                                            <strong t-elif="o.state in ['draft','sent']">QUOTE DATE:</strong>
                                            <strong t-else="">Order Date:</strong>
                                        </div>
                                        <div
                                            style="width: 50%; float: left; text-align: left; padding-left: 8px; box-sizing: border-box;">
                                            <span t-field="o.date_order"
                                                t-options="{&quot;widget&quot;: &quot;date&quot;}" />
                                        </div>
                                    </div>
                                </t>

                                <t t-if="o.validity_date and o.state in ['draft','sent']">
                                    <div name="expiration_date"
                                        style="width: 100%; clear: both; display: block; margin-bottom: 4px; line-height: 1.0;">
                                        <div
                                            style="width: 50%; float: left; text-align: right; color: #212529; padding-right: 8px; box-sizing: border-box;">
                                            <strong>QUOTE EXPIRY DATE:</strong>
                                        </div>
                                        <div
                                            style="width: 50%; float: left; text-align: left; padding-left: 8px; box-sizing: border-box;">
                                            <span t-field="o.validity_date"
                                                t-options="{&quot;widget&quot;: &quot;date&quot;}" />
                                        </div>
                                    </div>
                                </t>

                                <div style="clear: both;" />
                            </t>
                        </div>
                    </div>
                </div>


                <!--<div
                class="col-5 offset-1" name="company_address">
                    <ul class="list-unstyled" name="company_address_list">
                        <li t-if="company.is_company_details_empty"><span t-field="company.partner_id"
                t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;:
                [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: true}">
                            <div class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center
                justify-content-center p-4 w-100 opacity-75 text-muted text-center">
                                <strong>Company address block</strong>
                                <div>Contains the company address.</div>
                            </div>
                        </span></li>
                        <li t-else="">
                            <span t-field="company.company_details" class="text-nowrap">
                                <div class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center
                justify-content-center p-4 w-100 opacity-75 text-muted text-center">
                                    <strong>Company details block</strong>
                                    <div>Contains the company details.</div>
                                </div>
                            </span>
                        </li>
                        <li t-if="not forced_vat"/>
                        <li t-else="">
                            <t t-esc="company.country_id.vat_label or 'Tax ID'">Tax ID</t>:
                            <span t-esc="forced_vat">US12345671</span>
                        </li>
                    </ul>
                </div>-->
            </div>
            <!-- Page 1: full letterhead / Page 2+: continuation logo only (same header space, old paperformat) -->
            <t t-set="continuation_logo"
                t-value="('continuation_logo' in company._fields and company.continuation_logo) or company.logo" />
            <div t-if="report_type == 'pdf'" class="o_continuation_header text-end" style="display: none;">
                <img t-if="continuation_logo" t-att-src="image_data_uri(continuation_logo)" alt="Logo"
                    style="max-height: 180px !important; max-width: none !important; width: 325px !important; height: auto !important;" />
            </div>
            <script t-if="report_type == 'pdf'">
                (function () {
                    var vars = {};
                    document.location.search.substring(1).split('&amp;').forEach(function (kv) {
                        var p = kv.split('=', 2);
                        vars[p[0]] = decodeURIComponent(p[1] || '');
                    });
                    var first = vars.sitepage ? vars.sitepage === '1' : (vars.page || '1') === '1';
                    if (!first) {
                        var i;
                        var letterheads = document.getElementsByClassName('o_first_page_letterhead');
                        for (i = 0; i &lt; letterheads.length; i++) {
                            letterheads[i].style.display = 'none';
                        }
                        var continuations = document.getElementsByClassName('o_continuation_header');
                        for (i = 0; i &lt; continuations.length; i++) {
                            continuations[i].style.display = 'block';
                        }
                    }
                })();
            </script>
        </div>

        <t t-set="layout_background_url"
            t-value="'data:image/png;base64,%s' % company.layout_background_image.decode('utf-8') if company.layout_background_image and company.layout_background == 'Custom' else                 '/base/static/img/demo_logo_report.png' if company.layout_background == 'Demo logo' else ''" />
        <div
            t-attf-class="article o_report_layout_bold o_table_bold o_company_#{company.id}_layout o_snail_mail {{'o_report_layout_background' if company.layout_background != 'Blank' else ''}}"
            t-attf-style="{{ 'background-image: url(%s);' % layout_background_url if layout_background_url else '' }}"
            t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id"
            t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-call="web.address_layout" />
            <h2 t-out="layout_document_title" />
            <t t-out="0" />
        </div>

        <div
            t-attf-class="footer o_company_#{company.id}_layout {{report_type != 'pdf' and 'mt-auto'}}">
            <div class="o_footer_content row pt-2">
                <div class="col-8 text-start">
                    <span t-field="company.report_footer" />
                    <!-- Footer Image -->
                    <t t-if="company and 'footer_logo' in company._fields">
                        <div style="text-align: center; margin-top: 10px;">
                            <img t-att-src="image_data_uri(company.footer_logo)" alt="Footer Image"
                                style="height: 120px; max-height: 120px; display: block; margin: 0 auto;" />
                        </div>
                    </t>


                </div>
                <div class="col-6 text-end">
                    <strong t-if="company.report_header" t-field="company.report_header"
                        class="o_company_tagline">Company tagline</strong>
                    <span t-if="report_type == 'pdf' and display_name_in_footer" class="text-muted"
                        t-out="str(o.name) + ', '">(document name)</span>
                    <span t-if="report_type == 'pdf'" class="text-muted">Page <span class="page" />
                        / <span class="topage" /></span>

                </div>
            </div>
        </div>
    </template>

    <record id="report_layout_cguk_bold" model="report.layout">
        <field name="name">CGUK Bold</field>
        <field name="sequence">50</field>
        <field name="view_id" ref="tl_worksheet_form_report.external_layout_bold"/>
    </record>
</odoo>
