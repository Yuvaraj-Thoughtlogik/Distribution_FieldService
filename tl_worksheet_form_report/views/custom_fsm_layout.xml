<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Custom Paperformat for Field Service Reports configured for the 130px logo and header -->
        <record id="paperformat_fsm_report" model="report.paperformat">
            <field name="name">FSM Report Paperformat</field>
            <field name="default" eval="False" />
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">40</field>
            <field name="margin_bottom">36</field>
            <field name="margin_left">5</field>
            <field name="margin_right">5</field>
            <field name="header_line" eval="False" />
            <field name="header_spacing">35</field>
            <field name="dpi">90</field>
        </record>

        <!-- Assign the custom paperformat to Field Service report action -->
        <record id="planning_field_service.intervention_report" model="ir.actions.report">
            <field name="paperformat_id" ref="tl_worksheet_form_report.paperformat_fsm_report" />
        </record>

        <template id="custom_fsm_layout">
            <t t-if="not o" t-set="o" t-value="doc" />
            <t t-if="not company">
                <t t-if="company_id">
                    <t t-set="company" t-value="company_id" />
                </t>
                <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                    <t t-set="company" t-value="o.company_id.sudo()" />
                </t>
                <t t-else="else">
                    <t t-set="company" t-value="res_company" />
                </t>
            </t>

            <div t-attf-class="header o_company_#{company.id}_layout"
                t-att-style="report_header_style">
                <div class="row">
                    <!-- Customer Address on Left Header (Page 1 Only) -->
                    <div class="col-6 text-start"
                        style="font-size: 13px; line-height: 1.3; color: #212529;">
                        <div id="first_page_customer_address">
                            <t t-if="o and 'partner_id' in o._fields and o.partner_id">
                                <div style="font-weight: bold;">
                                    <span t-field="o.partner_id.name" />
                                </div>
                                <div t-if="'company_name' in o._fields and o.company_name">
                                    <span t-field="o.company_name" />
                                </div>
                                <div t-if="o.partner_id.street">
                                    <span t-field="o.partner_id.street" />
                                </div>
                                <div t-if="o.partner_id.street2">
                                    <span t-field="o.partner_id.street2" />
                                </div>
                                <div t-if="o.partner_id.city">
                                    <span t-field="o.partner_id.city" />
                                </div>
                                <div t-if="o.partner_id.state_id">
                                    <span t-field="o.partner_id.state_id.name" />
                                </div>
                                <div t-if="o.partner_id.zip">
                                    <span t-field="o.partner_id.zip" />
                                </div>
                                <div t-if="o.partner_id.country_id">
                                    <span t-field="o.partner_id.country_id.name" />
                                </div>
                            </t>
                        </div>
                    </div>

                    <!-- Company Logo on Right Header (+50px size: 130px max-height) -->
                    <div class="col-6 text-end">
                        <img t-if="company.logo" class="o_company_logo_big"
                            t-att-src="image_data_uri(company.logo)" alt="Logo"
                            style="max-height: 130px; max-width: 320px; height: auto; width: auto; object-fit: contain; margin-bottom: 0px;"
                        />
                    </div>
                </div>

                <!-- JavaScript for wkhtmltopdf to hide customer address on subsequent pages (pages
                > 1) -->
                <script type="text/javascript">
                    (function() {
                        var vars = {};
                        var x = window.location.search.substring(1).split('&amp;');
                        for (var i = 0; i &lt; x.length; i++) {
                            var z = x[i].split('=', 2);
                            vars[z[0]] = unescape(z[1]);
                        }
                        var p = vars['page'] || vars['sitepage'];
                        if (p &amp;&amp; parseInt(p) &gt; 1) {
                            var el = document.getElementById('first_page_customer_address');
                            if (el) {
                                el.style.display = 'none';
                            }
                        }
                    })();
                </script>
            </div>

            <div
                t-attf-class="article o_report_layout_bold o_table_bold o_company_#{company.id}_layout"
                t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id"
                t-att-data-oe-lang="o and o.env.context.get('lang')">
                <t t-out="0" />
            </div>

            <!-- <div
                t-attf-class="footer o_company_#{company.id}_layout {{report_type != 'pdf' and 'mt-auto'}}">
                <div class="o_footer_content row pt-2">
                    <div class="col-8 text-start">
                        <span t-field="company.report_footer" />
                        <t
                            t-if="company and 'footer_logo' in company._fields and company.footer_logo">
                            <div style="text-align: center; margin-top: 5px;">
                                <img t-att-src="image_data_uri(company.footer_logo)"
                                    alt="Footer Image"
                                    style="height: 80px; max-height: 80px; display: block; margin: 0 auto;" />
                            </div>
                        </t>
                    </div>
                    <div class="col-4 text-end">
                        <strong t-if="company.report_header" t-field="company.report_header"
                            class="o_company_tagline">Company tagline</strong>
                        <span t-if="report_type == 'pdf' and display_name_in_footer"
                            class="text-muted"
                            t-out="str(o.name) + ', '">(document name)</span>
                    </div>
                </div>
            </div> -->
            <div
                t-attf-class="footer o_company_#{company.id}_layout {{report_type != 'pdf' and 'mt-auto'}}">
                <div class="o_footer_content row p-2">
                    <div class="col-8 text-start">
                        <span t-field="company.report_footer" />
                        <!-- Footer Image -->
                        <t t-if="company and 'footer_logo' in company._fields">
                            <div style="text-align: center; margin-top: 10px;">
                                <img t-att-src="image_data_uri(company.footer_logo)"
                                    alt="Footer Image"
                                    style="height: 120px; max-height: 120px; display: block; margin: 0 auto;" />
                            </div>
                        </t>


                    </div>
                    <div class="col-6 text-end">
                        <strong t-if="company.report_header" t-field="company.report_header"
                            class="o_company_tagline">Company tagline</strong>
                        <span t-if="report_type == 'pdf' and display_name_in_footer"
                            class="text-muted"
                            t-out="str(o.name) + ', '">(document name)</span>
                        <span t-if="report_type == 'pdf'" class="text-muted">Page <span class="page" />
                            / <span class="topage" /></span>

                    </div>
                </div>
            </div>
        </template>
    </data>
</odoo>