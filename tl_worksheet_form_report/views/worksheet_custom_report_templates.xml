<odoo>
  <data>

      <template id="tl_worksheet_form_report.worksheet_custom_page" inherit_id="industry_fsm_report.worksheet_custom_page">
          <xpath expr="//div[@name='worksheet_map']" position="attributes">
              <attribute name="style">padding-top:20px;</attribute>
          </xpath>
          <xpath expr="//div[@name='worksheet_map']//br" position="replace"/>
           <xpath expr="//div[@name='worksheet_map']//h2" position="replace">
                <h4>Worksheet</h4>
            </xpath>
          <xpath expr="//t[@t-call='#{doc.worksheet_template_id.report_view_id.id}']" position="replace">
              <t t-raw="doc.generate_worksheet_html(doc.worksheet_template_id.id)"/>
          </xpath>
        </template>

  </data>
</odoo>
