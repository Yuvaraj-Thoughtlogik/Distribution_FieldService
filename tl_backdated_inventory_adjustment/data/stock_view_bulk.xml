<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="action_bulk_backdate_inventory" model="ir.actions.act_window">
    <field name="name">Backdate Inventory</field>
    <field name="res_model">bulk.inventory.backdate.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    <field name="context">{'default_quant_ids': active_ids}</field>
  </record>

  <record id="server_action_quant_backdate" model="ir.actions.server">
    <field name="name">Backdate Inventory</field>
    <field name="model_id" ref="stock.model_stock_quant"/>
    <field name="binding_model_id" ref="stock.model_stock_quant"/>
    <field name="binding_type">action</field>
    <field name="state">code</field>
    <field name="code">
      action = {
        'type': 'ir.actions.act_window',
        'res_model': 'bulk.inventory.backdate.wizard',
        'view_mode': 'list',
        'target': 'new',
        'context': {'default_quant_ids': active_ids},
      }
    </field>
  </record>

</odoo>

