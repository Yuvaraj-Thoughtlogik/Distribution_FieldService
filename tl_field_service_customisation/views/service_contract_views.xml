<odoo>
    <record id="service_contract_view_form" model="ir.ui.view">
        <field name="name">service_contract_view_form</field>
        <field name="model">service.contract</field>
        <field name="arch" type="xml">
            <form string="service_contract_form">
                <header>
                    <button name="send_sign_email"
                            string="Send by Email"
                            type="object"
                            class="btn-primary"
                    />
<!--                    <button name="create_sign_request"-->
<!--                            string="Create Sign Request"-->
<!--                            type="object"-->
<!--                            class="btn-primary"-->
<!--                            invisible="current_sign_id"-->
<!--                    />-->
                    <button name="share_sign_link"
                            string="Share Sign Link"
                            type="object"
                            invisible="not current_sign_id"
                    />
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,active,upcoming,pending,done,cancelled,terminated"/>
                </header>
                <sheet>
                    <div class="oe_stat_button" name="button_box">
                        <button name="open_current_subscription"
                                type="object"
                                class="oe_stat_button"
                                string="Current Sign Document"
                                icon="fa-dollar"
                                invisible ="not current_subscription_id">
                            <field name="current_subscription_id" widget="statinfo"/>
                        </button>

                        <button name="open_sign_request"
                                type="object"
                                class="oe_stat_button"
                                string="Current Sign Document"
                                icon="fa-dollar"
                                invisible ="not current_sign_id">
                            <field name="current_sign_id" widget="statinfo"/>
                        </button>

                        <button name="open_subscription_history"
                                type="object"
                                class="oe_stat_button"
                                string="Subscription History"
                                icon="fa-dollar"
                                invisible ="history_count &lt; 2">
                            <field name="history_count" string="Subscription History" widget="statinfo"/>
                        </button>

                    </div>
                    <div class="oe_title">
                        <label for="name" string="Contract Number"/>
                        <h1><field name="name" placeholder="e.g. Non-disclosure agreement" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" widget="res_partner_many2one" placeholder="Type to find a customer..." readonly="1"/>
                            <field name="partner_shipping_id" widget="res_partner_many2one" context="{'res_partner_search_mode': 'customer', 'show_address': 1, 'show_vat': True}" placeholder="Type to find a customer..." readonly="1"/>

                        </group>
                        <group>
                            <field name="product_id" />

                            <field name="sale_id" readonly="1"/>
                            <field name="asset_ids" widget="many2many_tags"/>
                            <label name="plan_label" for="start_date"/>
                            <div name="plan_block" class="o_row">
                                <field name="start_date"/>
                                <span>until</span>
                                <field name="end_date" />
                            </div>
                            <field name="next_recurring_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="contracts" string="Contracts">
                            <field name="contract_line_ids">
                                <list>
                                    <control>
                                        <button/>
                                    </control>
                                    <field name="name"  readonly="1"/>
                                    <field name="start_date" string="Start"/>
                                    <field name="end_date" string="End"/>
                                    <field name="sale_id" column_invisible="1" readonly="1"/>
                                    <field name="state"/>
                                    <field name="sign_request_id" readonly="1"/>
                                    <field name="sign_status" readonly="1"/>
                                </list>

                                <form string="Annual Service Contract" >
<!--                                    <header>-->
<!--                                        <field name="state"-->
<!--                                               widget="statusbar"-->
<!--                                               statusbar_visible="draft,active,upcoming,pending,done,cancelled,terminated"/>-->
<!--                                    </header>-->
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="name"/>
                                                <field name="sale_id"  readonly="1"/>
                                                <field name="sign_request_id" readonly="1"/>
                                            </group>
                                            <group>
                                                <field name="state"/>
                                                <field name="start_date"/>
                                                <field name="end_date"/>
                                            </group>
                                        </group>
                                        <notebook>
                                            <page name="Signed Document" invisible="not signed_document">
                                                <field name="signed_document" widget="pdf_viewer" readonly="1"/>
                                            </page>
                                        </notebook>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page name="Signed Document" invisible="not signed_document">
                            <field name="signed_document" widget="pdf_viewer"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="service_contract_view_list" model="ir.ui.view">
        <field name="name">service_contract_view_list</field>
        <field name="model">service.contract</field>
        <field name="arch" type="xml">
            <list string="service_contract_list">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="asset_ids" widget="many2many_tags"/>
                <field name="start_date"/>
                <field name="next_recurring_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="service_contract_view_action" model="ir.actions.act_window">
        <field name="name">Service Contract</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">service.contract</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="service_contract_menu_categ" name="Service Contracts" parent="cguk_customer_asset.menu_customer_asset_root" action="service_contract_view_action" sequence="20"/>
</odoo>