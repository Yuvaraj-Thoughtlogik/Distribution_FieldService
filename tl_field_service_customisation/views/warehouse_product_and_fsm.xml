<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_task_form2_warehouse_inherit" model="ir.ui.view">
        <field name="name">project.task.form.warehouse</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="customer_assets_ids" widget="many2many_tags"  />
                <field name="warehouse_id" options="{'no_create': True}" placeholder="Visible to all"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_form_view_warehouse_inherit" model="ir.ui.view">
        <field name="name">product.template.common.form.warehouse</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//group[@name='group_standard_price']//field[@name='company_id']" position="after">
                <field name="warehouse_id" options="{'no_create': True}" placeholder="Visible to all"/>
            </xpath>
        </field>
    </record>
</odoo>