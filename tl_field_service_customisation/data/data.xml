<odoo>
    <record id="crm_team_service_contracts" model="crm.team">
        <field name="name">Service Contracts</field>
        <field name="active">True</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="use_opportunities">True</field>
        <field name="use_leads">True</field>
    </record>

    <record id="cron_subscription_renewal_opportunity" model="ir.cron">
        <field name="name">Create Renewal Opportunities</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">model.action_create_renewal_opportunity()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>