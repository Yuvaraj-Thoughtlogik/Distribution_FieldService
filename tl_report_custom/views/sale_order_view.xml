<!-- Inherit Form View to Modify it -->
<odoo>
    <record id="sale_extra_description" model="ir.ui.view">
        <field name="name">sale.order.extra_description</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='order_lines']//field[@name='order_line']//list[@name='sol_list']/column[@name='product_and_description']" position="after">
                <field name="description" class="desc-wide"/>
            </xpath>
            <xpath expr="//page[@name='order_lines']//field[@name='order_line']" position="attributes">
                <attribute name="class">desc-wide-line</attribute>
            </xpath>

        </field>
    </record>
</odoo>
