<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_picking_inherit" inherit_id="stock.report_picking">
        <xpath expr="//t/t/t/div/table[1]/thead/tr/th[@name='th_product']" position="after">
            <th name="th_product_image">
                <div><strong>Image</strong></div>
            </th>
        </xpath>
        <xpath expr="//t/t/t/div/table[1]/tbody/tr/td[1]" position="after">
            <td>
                <t t-if="ml.product_id.image_1920">
                    <img t-att-src="image_data_uri(ml.product_id.image_1920)" style="height:50px;width:50px;" alt="Product Image"/>
                </t>
            </td>
        </xpath>
    </template>
</odoo>