<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_select_lot_wizard" model="ir.ui.view">
        <field name="name">select.lot.wizard.form</field>
        <field name="model">select.lot.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Lot">
                <group>
                    <field name="product_id" readonly="1"/>
                    <field name="lot_id"/>
                </group>
                <footer>
                    <button string="Confirm" type="object" name="confirm" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>