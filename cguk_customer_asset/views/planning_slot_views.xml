<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="planning_view_form_customer_assets" model="ir.ui.view">
        <field name="name">planning.slot.form.customer.assets</field>
        <field name="model">planning.slot</field>
        <field name="inherit_id" ref="planning.planning_view_form"/>
        <field name="priority">45</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_phone'][2]" position="after">
                <field name="parent_company" invisible="1"/>
                <field name="customer_assets_ids" widget="many2many_tags" readonly="not can_edit"
                       invisible="not partner_id" options="{'no_create': True}"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_customer_assets"
                        type="object"
                        class="oe_stat_button"
                        invisible="not customer_assets_ids"
                        icon="fa-cubes">
                    <field name="customer_assets_count" widget="statinfo" string="Customer Assets"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="planning_view_tree_customer_assets" model="ir.ui.view">
        <field name="name">planning.slot.list.customer.assets</field>
        <field name="model">planning.slot</field>
        <field name="inherit_id" ref="planning.planning_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='role_id']" position="after">
                <field name="customer_assets_ids" widget="many2many_tags" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="planning_slot_view_search_customer_assets" model="ir.ui.view">
        <field name="name">planning.slot.search.customer.assets</field>
        <field name="model">planning.slot</field>
        <field name="inherit_id" ref="planning.planning_view_search_base"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='role_id']" position="after">
                <field name="customer_assets_ids"/>
            </xpath>
        </field>
    </record>
</odoo>
