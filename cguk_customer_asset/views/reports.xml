<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="sale_order_line_view_inherit_total_price" model="ir.ui.view">
        <field name="name">sale.order.line.inherit.total.price</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='tax_ids']" position="after">
                <field name="order_line_total_price" readonly="1" column_invisible="1"/>
                <field name="cost_price" readonly="1" column_invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_form_inherit_partner_fields" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.partner.details</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="individual_name" readonly="1" invisible="1"/>
                <field name="related_address" widget="text" invisible="1"/>
                <field name="company_name" readonly="1" invisible="1"/>
                <field name="contact_address" widget="text" readonly="1" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_company_form_inherit_footer_logo" model="ir.ui.view">
        <field name="name">res.company.form.footer.logo</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='logo']" position="after">
                <field name="footer_logo" widget="image" class="oe_avatar" options="{'preview_image': 'footer_logo'}"/>
                <field name="fritsch_logo" widget="image" class="oe_avatar" options="{'preview_image': 'fritsch_logo'}"/>
                <field name="continuation_logo" widget="image" class="oe_avatar" options="{'preview_image': 'continuation_logo'}"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_form_inherit_report_type" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.report.type</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="report_type" required="1"/>
            </xpath>
        </field>
    </record>
</odoo>
