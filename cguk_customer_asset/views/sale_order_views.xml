<odoo>
    <record id="sale_order_line_inherit_form" model="ir.ui.view">
        <field name="name">sale.order.line.inherit.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="before">
                <field name="subscription_customer_assets_ids"
                       widget="many2many_tags"
                       invisible="not is_subscription"
                       readonly="state in ['sale','cancel'] or origin_order_id"
                />
                <field name="is_subscription"/>
            </xpath>
<!--            <xpath expr="//page[@name='order_lines']" position="after">-->
<!--                <page name="Customer Assets">-->
<!--                <group string="Customer Assets">-->
<!--                <field name="subscription_customer_assets_ids" nolabel="1" widget="many2many" invisible="not is_subscription">-->
<!--                    <list>-->
<!--                        <field name="name" string="Asset Number"/>-->
<!--                        <field name="product_id"/>-->
<!--                        <field name="company_id"/>-->
<!--                    </list>-->
<!--                </field>-->
<!--                </group>-->
<!--                </page>-->
<!--            </xpath>-->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_sale_customer_assets"
                        string="Customer Assets"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-cubes"
                        invisible="not sale_customer_assets_ids">
                    <field name="sale_customer_assets_count" widget="statinfo" string="Customer Assets"/>
                </button>
                <button name="action_view_subscription_customer_assets"
                        string="Customer Assets"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-cubes"
                        invisible="not subscription_customer_assets_ids">
                    <field name="subscription_customer_assets_count" widget="statinfo" string="Customer Assets"/>
                </button>
            </xpath>
        </field>
    </record>
    <!-- Inherit Form View to Modify it -->
    <record id="view_picking_form_track_cpe" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='operations']/field[@name='move_ids']/list/column[field[@name='product_id']]" position="after">
                <field name="track_cpe" column_invisible="parent.hide_track_cpe"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_customer_assets"
                        string="Customer Assets"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-cubes"
                        invisible="not customer_assets_ids">
                    <field name="customer_assets_count" widget="statinfo" string="Customer Assets"/>
                </button>
            </xpath>
        </field>
    </record>
    <!-- Inherit Form View to Modify it -->
    <record id="product_template_only_form_view_trackcpe" model="ir.ui.view">
        <field name="name">product.template.product.form.trackCPE</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='invoice_policy']" position="before">
                <!-- Add your fields or attributes here -->
                <field name="track_cpe"/>
            </xpath>

        </field>
    </record>
</odoo>
