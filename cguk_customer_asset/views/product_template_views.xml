<odoo>
    <record id="view_product_template_subscription_service_field" model="ir.ui.view">
        <field name="name">product.template.subscription.service.field</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='service_tracking']" position="before">

                    <field name="number_of_services_per_year"
                       invisible = "recurring_invoice != True" required="type=='service'"/>

            </xpath>
            <xpath expr="//field[@name='service_policy']" position="after">

                    <field name="fsm_task_creation_mode"
                       invisible="service_tracking not in ('task_global_project', 'task_in_project')"
                       required="service_tracking in ('task_global_project', 'task_in_project')"/>

            </xpath>
        </field>
    </record>
</odoo>
