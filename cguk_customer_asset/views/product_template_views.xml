<odoo>
    <record id="view_product_template_subscription_service_field" model="ir.ui.view">
        <field name="name">product.template.subscription.service.field</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="sale_planning.product_template_form_view_invoice_policy_inherit_sale_planning"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='service_policy_div']" position="after">
                <field name="recurring_invoice" invisible="1"/>
                <field name="number_of_services_per_year"
                       invisible="not recurring_invoice" required="type == 'service' and recurring_invoice"/>
                <field name="fsm_task_creation_mode"
                       invisible="not planning_enabled"
                       required="planning_enabled"/>
            </xpath>
        </field>
    </record>
</odoo>
