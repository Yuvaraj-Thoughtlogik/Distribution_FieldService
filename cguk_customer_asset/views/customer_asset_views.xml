<odoo>
  <record id="view_customer_asset_form" model="ir.ui.view">
    <field name="name">customer.asset.form</field>
    <field name="model">customer.asset</field>
    <field name="arch" type="xml">
      <form string="Customer Asset">
        <header>
          <button name="action_plan_intervention" type="object" string="Plan Intervention" class="btn-primary" groups="planning.group_planning_user"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_view_subscription"
                    string="Subscription"
                    invisible ="not subscription_id"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-refresh">
              <field name="subscription_id"
                     widget="statinfo"
                     string="Subscription"
              />
            </button>
            <button name="action_view_sale_order"
                    invisible ="not sale_order_id"
                    string="Sale Order"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-bar-chart">
              <field name="sale_order_id"
                     widget="statinfo"
                     string="Sale Order"
              />
            </button>
            <button name="action_view_ticket"
                    string="Helpdesk Ticket"
                    invisible ="not helpdesk_ticket_ids"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-life-ring">
              <span class="o_stat_text">Helpdesk</span>
            </button>
            <button name="action_view_interventions"
                    groups="planning.group_planning_user"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-tasks">
              <field name="intervention_count" widget="statinfo" string="Interventions"/>
            </button>
            <button name="action_view_delivery_order"
                    string="Delivery Order"
                    invisible="not stock_picking_id"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-truck">
              <field name="stock_picking_id"
                     widget="statinfo"
                     string="Delivery Order"
              />
            </button>
            <button name="action_view_repair_order" string="Repair Order" invisible="not repair_order_ids" type="object" class="oe_stat_button" icon="fa-wrench"/>
          </div>
          <div class="oe_title">
            <h1>
              <label for="display_name" string="Name"/>
              <field name="display_name" readonly="1"/>
            </h1>
            <hr/>
          </div>
          <group>
            <group>
              <field name="product_id"/>
              <field name="product_serial_No"/>
              <field name="customer_company_id" readonly="0"/>
              <field name="contact_id" invisible="not customer_company_id" domain="[('parent_id','=',customer_company_id)]"/>
              <field name="contact_id" invisible="customer_company_id" domain="[('is_company','=',False)]"/>
              <label for="street" string="Main Address"/>
              <div class="o_address_format">
                <field name="street" placeholder="Street..." class="o_address_street"/>
                <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                <field name="city" placeholder="City" class="o_address_city"/>
                <field name="state_id" class="o_address_state" placeholder="State" options="{'no_open': True, 'no_quick_create': True}" context="{'default_country_id': country_id}"/>
                <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                <field name="country_id" placeholder="Country" class="o_address_country" options='{"no_open": True, "no_create": True}'/>
                <field name="country_code" />
              </div>
              <field name="same_as_main_address"/>
              <label for="delivery_street" string="Service Address"/>
              <div class="o_address_format">
                <field name="delivery_address_id"/>
                <field name="delivery_street" placeholder="Street..." class="o_address_street"/>
                <field name="delivery_street2" placeholder="Street 2..." class="o_address_street"/>
                <field name="delivery_city" placeholder="City" class="o_address_city"/>
                <field name="delivery_state_id" class="o_address_state" placeholder="State" options="{'no_open': True, 'no_quick_create': True}" context="{'default_delivery_country_id': delivery_country_id}"/>
                <field name="delivery_zip" placeholder="ZIP" class="o_address_zip"/>
                <field name="delivery_country_id" placeholder="Country" class="o_address_country" options='{"no_open": True, "no_create": True}'/>
                <field name="delivery_country_code" />
              </div>
            </group>
            <group>
              <field name="active_asset"/>
              <field name="sale_date"/>
              <field name="install_date"/>
              <field name="helpdesk_ticket_ids"
                     context="{
                     'default_partner_id': contact_id,
                     'default_customer_assets_id': id
                 }" widget="many2many_tags"/>
              <field name="subscription_id" readonly="1"/>
              <field name="sale_order_id"/>
              <field name="intervention_ids" widget="many2many_tags" groups="planning.group_planning_user"
                     context="{'default_partner_id': delivery_address_id or contact_id or customer_company_id}"/>
              <field name="stock_picking_id"/>
              <field name="repair_order_ids" widget="many2many_tags"/>
            </group>
          </group>
          <notebook>
            <page string="Service Contract Info">
              <group>
                <group>
                  <field name="active_contract"/>
                  <field name="contract_renewal_date"/>
                </group>
                <group>
                  <field name="contract_start_date"/>
                  <field name="contract_end_date"/>

                </group>
              </group>
            </page>
            <page string="Warranty Info">
              <group>
                <field name="under_warranty"/>
                <field name="warranty_expiry"/>
              </group>
            </page>
          </notebook>
        </sheet>

        <chatter/>
      </form>

    </field>
  </record>

  <record id="view_customer_asset_list" model="ir.ui.view">
    <field name="name">customer.asset.list</field>
    <field name="model">customer.asset</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="product_id"/>
        <field name="active_asset" width="100%"/>
        <field name="product_serial_No"/>
        <field name="stock_picking_id"/>
        <field name="sale_date"/>
        <field name="customer_company_id"/>
      </list>
    </field>
  </record>

  <record id="view_customer_asset_search" model="ir.ui.view">
    <field name="name">customer.asset.search</field>
    <field name="model">customer.asset</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="product_id"/>
        <field name="product_serial_No"/>
        <field name="customer_company_id"/>
        <field name="contact_id"/>
        <field name="sale_order_id"/>
        <field name="subscription_id"/>
        <filter name="filter_active_asset" string="Active" domain="[('active_asset', '=', True)]"/>
        <filter name="filter_under_warranty" string="Under Warranty" domain="[('under_warranty', '=', True)]"/>
        <separator/>
        <filter name="groupby_company" string="Company" context="{'group_by': 'customer_company_id'}"/>
        <filter name="groupby_product" string="Product" context="{'group_by': 'product_id'}"/>
      </search>
    </field>
  </record>

  <record id="action_customer_asset" model="ir.actions.act_window">
    <field name="name">Customer Assets</field>
    <field name="res_model">customer.asset</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_customer_asset_root" name="Customer Assets"/>
  <menuitem id="menu_customer_asset" name="Assets" parent="menu_customer_asset_root"
            action="action_customer_asset"/>
</odoo>
