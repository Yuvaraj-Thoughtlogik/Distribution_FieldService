<odoo>
    <data>
        <record id="view_partner_form_inherit_customer_asset" model="ir.ui.view">
            <field name="name">res.partner.form.inherit.customer.asset</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_customer_assets"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-cubes">
                        <field name="customer_asset_count" string="Customer Asset" widget="statinfo"/>

                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
