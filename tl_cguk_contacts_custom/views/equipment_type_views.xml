<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="equipment_form_view" model="ir.ui.view">
            <field name="name">equipment.type.view.form</field>
            <field name="model">equipment.type</field>
            <field name="arch" type="xml">
                <form string="Equipment Type">
                    <sheet>
                        <label for="name" string="Name"/>
                        <field name="name"/>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="equipment_view_tree" model="ir.ui.view">
            <field name="name">equipment.type.view.list</field>
            <field name="model">equipment.type</field>
            <field name="arch" type="xml">
                <list string="Equipment Type">
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="equipment_type_action" model="ir.actions.act_window">
            <field name="name">Equipment Type</field>
            <field name="res_model">equipment.type</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem id="equipment_type_menu" name="Equipment Type" sequence="2"
                  action="equipment_type_action"
                  parent="contacts.res_partner_menu_config"/>

