<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Quote-only website: no price in the "item added" notification -->
    <t t-inherit="website_sale.CartNotificationLine" t-inherit-mode="extension">
        <xpath expr="//div[@t-if='!line.linked_line_id']" position="replace"/>
    </t>
    <t t-inherit="website_sale.ItemAddedNotification" t-inherit-mode="extension">
        <xpath expr="//a[@href='/shop/cart']" position="replace">
            <a role="button" class="w-100 btn btn-primary" href="/shop/cart">View quote request</a>
        </xpath>
    </t>
</templates>
