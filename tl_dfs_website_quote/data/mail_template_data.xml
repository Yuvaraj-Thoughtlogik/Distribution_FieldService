<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_tag_website_quote" model="crm.tag">
        <field name="name">Website quote</field>
    </record>

    <record id="mail_template_quote_request_ack" model="mail.template">
        <field name="name">Website: Quote request acknowledgement</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="subject">{{ object.company_id.name or 'We' }} - we have received your quote request</field>
        <field name="email_from">{{ object.company_id.email_formatted or object.user_id.email_formatted }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="description">Sent to the customer when a quote request is submitted on the website (no prices).</field>
        <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-size: 14px;">
    <t t-set="quote_order" t-value="object.order_ids[:1]"/>
    <p style="margin: 0px; padding: 0px;">
        Dear <t t-out="object.contact_name or object.partner_id.name or ''">customer</t>,
        <br/><br/>
        Thank you for your interest in our laboratory equipment and services.
        We have received your quote request<t t-if="quote_order"> <strong t-out="quote_order.name or ''">S00001</strong></t>
        and one of our specialists will come back to you with a tailored quotation shortly.
        <br/><br/>
        <strong>Requested items</strong>
    </p>
    <table t-if="quote_order" style="width: 100%; border-collapse: collapse; margin: 8px 0 16px 0;">
        <tr style="background-color: #F2F4F7;">
            <th style="text-align: left; padding: 6px 8px;">Product</th>
            <th style="text-align: right; padding: 6px 8px;">Quantity</th>
        </tr>
        <t t-foreach="quote_order.order_line" t-as="line">
            <tr t-if="not line.display_type and line.product_id" style="border-bottom: 1px solid #E5E7EB;">
                <td style="padding: 6px 8px;" t-out="line.product_id.display_name or ''">Product</td>
                <td style="padding: 6px 8px; text-align: right;">
                    <t t-out="line.product_uom_qty" t-options="{'widget': 'float', 'precision': 0}">1</t>
                    <t t-out="line.product_uom_id.name or ''">Units</t>
                </td>
            </tr>
        </t>
    </table>
    <p style="margin: 0px; padding: 0px;">
        If you need installation, calibration or a service contract with your equipment,
        simply reply to this e-mail and let us know.
        <br/><br/>
        Kind regards,<br/>
        <t t-out="object.company_id.name or ''">The team</t>
    </p>
</div>
        </field>
    </record>
</odoo>
