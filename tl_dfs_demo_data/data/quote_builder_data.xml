<?xml version="1.0" encoding="utf-8"?>
<!-- PDF Quote Builder documents (generated by tools/gen_quote_pdfs.py).
     Quotation templates using them are created by tl.dfs.demo.loader._setup_quote_templates. -->
<odoo>
<data noupdate="1">

    <!-- Headers / footers -->
    <record id="quote_doc_cover" model="quotation.document">
        <field name="name">Cover - Northbrook Quotation</field>
        <field name="raw" type="bytes" file="tl_dfs_demo_data/static/pdf/quote_cover.pdf"/>
        <field name="mimetype">application/pdf</field>
        <field name="document_type">header</field>
        <field name="sequence">10</field>
        <field name="add_by_default" eval="True"/>
    </record>
    <record id="quote_doc_about" model="quotation.document">
        <field name="name">About Northbrook Analytical</field>
        <field name="raw" type="bytes" file="tl_dfs_demo_data/static/pdf/quote_about_us.pdf"/>
        <field name="mimetype">application/pdf</field>
        <field name="document_type">header</field>
        <field name="sequence">20</field>
        <field name="add_by_default" eval="True"/>
    </record>
    <record id="quote_doc_service" model="quotation.document">
        <field name="name">Installation, Warranty &amp; Service</field>
        <field name="raw" type="bytes" file="tl_dfs_demo_data/static/pdf/quote_service_support.pdf"/>
        <field name="mimetype">application/pdf</field>
        <field name="document_type">footer</field>
        <field name="sequence">30</field>
        <field name="add_by_default" eval="True"/>
    </record>
    <record id="quote_doc_terms" model="quotation.document">
        <field name="name">Terms of Sale &amp; Acceptance</field>
        <field name="raw" type="bytes" file="tl_dfs_demo_data/static/pdf/quote_terms.pdf"/>
        <field name="mimetype">application/pdf</field>
        <field name="document_type">footer</field>
        <field name="sequence">40</field>
        <field name="add_by_default" eval="True"/>
    </record>

    <!-- Product datasheets, selectable per quotation line -->
    <record id="product_doc_kd40" model="product.document">
        <field name="name">Datasheet NA-KD40</field>
        <field name="raw" type="bytes" file="tl_dfs_demo_data/static/pdf/datasheet_kd40.pdf"/>
        <field name="mimetype">application/pdf</field>
        <field name="res_model">product.template</field>
        <field name="res_id" ref="product_kd40"/>
        <field name="attached_on_sale">quotation</field>
    </record>
    <record id="product_doc_kd20" model="product.document">
        <field name="name">Datasheet NA-KD20</field>
        <field name="raw" type="bytes" file="tl_dfs_demo_data/static/pdf/datasheet_kd20.pdf"/>
        <field name="mimetype">application/pdf</field>
        <field name="res_model">product.template</field>
        <field name="res_id" ref="product_kd20"/>
        <field name="attached_on_sale">quotation</field>
    </record>
    <record id="product_doc_dn100" model="product.document">
        <field name="name">Datasheet NA-DN100</field>
        <field name="raw" type="bytes" file="tl_dfs_demo_data/static/pdf/datasheet_dn100.pdf"/>
        <field name="mimetype">application/pdf</field>
        <field name="res_model">product.template</field>
        <field name="res_id" ref="product_dn100"/>
        <field name="attached_on_sale">quotation</field>
    </record>
    <record id="product_doc_db20" model="product.document">
        <field name="name">Datasheet NA-DB20</field>
        <field name="raw" type="bytes" file="tl_dfs_demo_data/static/pdf/datasheet_db20.pdf"/>
        <field name="mimetype">application/pdf</field>
        <field name="res_model">product.template</field>
        <field name="res_id" ref="product_db20"/>
        <field name="attached_on_sale">quotation</field>
    </record>
    <record id="product_doc_fx6" model="product.document">
        <field name="name">Datasheet NA-FX6</field>
        <field name="raw" type="bytes" file="tl_dfs_demo_data/static/pdf/datasheet_fx6.pdf"/>
        <field name="mimetype">application/pdf</field>
        <field name="res_model">product.template</field>
        <field name="res_id" ref="product_fx6"/>
        <field name="attached_on_sale">quotation</field>
    </record>
    <record id="product_doc_fb6" model="product.document">
        <field name="name">Datasheet NA-FB6</field>
        <field name="raw" type="bytes" file="tl_dfs_demo_data/static/pdf/datasheet_fb6.pdf"/>
        <field name="mimetype">application/pdf</field>
        <field name="res_model">product.template</field>
        <field name="res_id" ref="product_fb6"/>
        <field name="attached_on_sale">quotation</field>
    </record>
    <record id="product_doc_mb120" model="product.document">
        <field name="name">Datasheet NA-MB120</field>
        <field name="raw" type="bytes" file="tl_dfs_demo_data/static/pdf/datasheet_mb120.pdf"/>
        <field name="mimetype">application/pdf</field>
        <field name="res_model">product.template</field>
        <field name="res_id" ref="product_mb120"/>
        <field name="attached_on_sale">quotation</field>
    </record>
    <record id="product_doc_rc12" model="product.document">
        <field name="name">Datasheet NA-RC12</field>
        <field name="raw" type="bytes" file="tl_dfs_demo_data/static/pdf/datasheet_rc12.pdf"/>
        <field name="mimetype">application/pdf</field>
        <field name="res_model">product.template</field>
        <field name="res_id" ref="product_rc12"/>
        <field name="attached_on_sale">quotation</field>
    </record>

</data>

<!-- Outside noupdate so it also runs on module update (idempotent). -->
<data>
    <function model="tl.dfs.demo.loader" name="_setup_quote_templates"/>
</data>
</odoo>
