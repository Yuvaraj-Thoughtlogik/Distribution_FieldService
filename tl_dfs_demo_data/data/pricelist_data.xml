<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="pricelist_trade" model="product.pricelist">
            <field name="name">UK Trade (GBP)</field>
            <field name="sequence">1</field>
            <field name="currency_id" ref="base.GBP"/>
        </record>

        <record id="pricelist_edu" model="product.pricelist">
            <field name="name">Education &amp; Public Sector (GBP)</field>
            <field name="sequence">5</field>
            <field name="currency_id" ref="base.GBP"/>
        </record>
        <record id="pricelist_edu_item_equipment" model="product.pricelist.item">
            <field name="pricelist_id" ref="pricelist_edu"/>
            <field name="applied_on">2_product_category</field>
            <field name="categ_id" ref="product_category_lab_equipment"/>
            <field name="compute_price">discount</field>
            <field name="price_discount" eval="12.5"/>
        </record>
        <record id="pricelist_edu_item_consumables" model="product.pricelist.item">
            <field name="pricelist_id" ref="pricelist_edu"/>
            <field name="applied_on">2_product_category</field>
            <field name="categ_id" ref="product_category_consumables"/>
            <field name="compute_price">discount</field>
            <field name="price_discount" eval="10"/>
        </record>
        <record id="pricelist_edu_item_services" model="product.pricelist.item">
            <field name="pricelist_id" ref="pricelist_edu"/>
            <field name="applied_on">2_product_category</field>
            <field name="categ_id" ref="product_category_services"/>
            <field name="compute_price">discount</field>
            <field name="price_discount" eval="5"/>
        </record>

        <record id="pricelist_key" model="product.pricelist">
            <field name="name">Key Accounts (GBP)</field>
            <field name="sequence">3</field>
            <field name="currency_id" ref="base.GBP"/>
        </record>
        <record id="pricelist_key_item_equipment" model="product.pricelist.item">
            <field name="pricelist_id" ref="pricelist_key"/>
            <field name="applied_on">2_product_category</field>
            <field name="categ_id" ref="product_category_lab_equipment"/>
            <field name="compute_price">discount</field>
            <field name="price_discount" eval="8"/>
        </record>
        <record id="pricelist_key_item_consumables_volume" model="product.pricelist.item">
            <field name="pricelist_id" ref="pricelist_key"/>
            <field name="applied_on">2_product_category</field>
            <field name="categ_id" ref="product_category_consumables"/>
            <field name="min_quantity" eval="10"/>
            <field name="compute_price">discount</field>
            <field name="price_discount" eval="15"/>
        </record>
    </data>
</odoo>
