<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- relocate to view file -->
    <record id="view_l10n_uk_reports_paye_fps_by_employees" model="ir.ui.view">
        <field name="name">l10n_uk_hr_paye_fps_by_employees</field>
        <field name="model">employee_paye_fps_return</field>
        <field name="arch" type="xml">
            <form string="FPS by Employees">
                <span nolabel="1" colspan="2">This wizard will generate a Full Payment Submission (FPS) form for all
                    selected employee(s) for payments in the specified period.
                </span>
                <separator/>
                <div class="o_row">
                    <!--
                    <label for="date_from"/>
                    <field name="date_from" class="o_hr_narrow_field" options="{'type': 'date'}"/>
                    <label for="date_to"/>
                    <field name="date_to" class="o_hr_narrow_field" options="{'type': 'date'}"/>
                    -->
                    <label for="run_id"/>
                    <field name="run_id"/>
                </div>
                <separator string="Employees"/>
                <field name="employee_ids" nolabel="1"/>
                <separator string="Information correct declaration"/>
                <div class="mb-2">
                    <field name="information_correct"/>
                    When you submit this PAYE FPS return, you are making a legal declaration that the information is
                    true and complete.
                </div>
                <div class="o_row">
                    <label for="late_reason" string="Is late?"/>
                    <field name="late_reason"/>
                </div>
                <div class="row">
                    <label for="hmrc_paye_password" string="Password" class="col-1"/>
                    <field name="hmrc_paye_password" password="True"/>
                </div>

                <footer>
                    <button string="Generate" name="generate_paye_fps" type="object" class="oe_highlight"
                            data-hotkey="q"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_paye_fps_by_employees" model="ir.actions.act_window">
        <field name="name">Generate FPS</field>
        <field name="res_model">employee_paye_fps_return</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_l10n_uk_reports_paye_fps_by_employees"/>
    </record>

    <menuitem
            id="l10n_uk_payroll_paye_fps"
            name="FPS - Full Payment Submission"
            sequence="35"
            action="action_hr_paye_fps_by_employees"
            parent="l10n_uk_hr_payroll.menu_reporting_l10n_uk"
    />

    <record id="view_l10n_uk_reports_paye_eps" model="ir.ui.view">
        <field name="name">l10n_uk_hr_paye_eps</field>
        <field name="model">employer_paye_eps_return</field>
        <field name="arch" type="xml">
            <form string="Employer Payment Summary">
                <span nolabel="1" colspan="2">This wizard will generate a Employer Payment Summary (EPS) form for all
                    selected employee(s) for payments in the specified period.
                </span>
                <separator/>
                <div class="o_row">
                    <label for="date_from"/>
                    <field name="date_from" class="o_hr_narrow_field" options="{'type': 'date'}"/>
                    <label for="date_to"/>
                    <field name="date_to" class="o_hr_narrow_field" options="{'type': 'date'}"/>
                </div>
                <separator string="Information correct declaration"/>
                <div class="mb-2">
                    <field name="information_correct"/>
                    When you submit this PAYE EPS return, you are making a legal declaration that the information is
                    true and complete.
                </div>
                <div class="row">
                    <label for="hmrc_paye_password" string="Password" class="col-1"/>
                    <field name="hmrc_paye_password" password="True"/>
                </div>

                <footer>
                    <button string="Generate" name="generate_paye_eps" type="object" class="oe_highlight"
                            data-hotkey="q"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_paye_eps" model="ir.actions.act_window">
        <field name="name">Generate EPS</field>
        <field name="res_model">employer_paye_eps_return</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_l10n_uk_reports_paye_eps"/>
    </record>

    <menuitem
            name="EPS - Employer Payment Summary"
            id="l10n_uk_payroll_paye_eps"
            parent="l10n_uk_hr_payroll.menu_reporting_l10n_uk"
            sequence="36"
            action="action_hr_paye_eps"/>

    <record id="fps_confirmation_wizard_view" model="ir.ui.view">
        <field name="name">fps.confirmation.wizard.form</field>
        <field name="model">hmrc.confirmation.wizard</field>
        <field name="arch" type="xml">
            <form string="FPS Sent">
                <group>
                    <field name="message" readonly="1" nolabel="1"/>
                </group>
                <footer>
                    <button special="cancel" string="OK" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
