<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="hmrc_paye_fps_return_body" name="HMRC PAYE FPS Return Request Body">
        <Body t-att="{'xmlns': 'http://www.govtalk.gov.uk/CM/envelope' if not ir_mark else None}">
            <IRenvelope t-att="{'xmlns': document['namespaces']['year']}">
                <IRheader>
                    <Keys>
                        <Key Type="TaxOfficeNumber" t-out="credentials.get('tax_office_number', '*****')"/>
                        <Key Type="TaxOfficeReference" t-out="credentials.get('tax_office_reference', '*****')"/>
                    </Keys>
                    <PeriodEnd t-out="document.get('period_end','XXXX-XX-XX')"/>
                    <IRmark Type="generic" t-out="ir_mark or ''"/>
                    <Sender>Employer</Sender>
                </IRheader>
                <FullPaymentSubmission>
                    <EmpRefs>
                        <OfficeNo t-out="credentials.get('tax_office_number', '*****')"/>
                        <PayeRef t-out="credentials.get('tax_office_reference', '*****')"/>
                        <AORef t-out="credentials.get('accounts_office_reference', '*****')"/>
                        <COTAXRef t-if="credentials.get('unique_taxpayer_reference')"
                                  t-out="credentials.get('unique_taxpayer_reference')"/>
                    </EmpRefs>
                    <RelatedTaxYear t-out="document['related_tax_year']"/>
                    <t t-foreach="document['employees']" t-as="employee">
                        <Employee>
                            <EmployeeDetails>
                                <NINO t-out="employee['nino']"/>
                                <Name>
                                    <Fore t-out="employee['forename']"/>
                                    <Sur t-out="employee['surname']"/>
                                </Name>
                                <Address>
                                    <Line t-if="employee.get('address1')" t-out="employee['address1']"/>
                                    <Line t-if="employee.get('address2')" t-out="employee['address2']"/>
                                    <Line t-if="employee.get('address3')" t-out="employee['address3']"/>
                                    <UKPostcode t-if="len(['postcode']) > 0" t-out="employee['postcode']"/>
                                </Address>
                                <BirthDate t-out="employee['dob']"/>
                                <Gender t-out="employee['gender']"/>
                            </EmployeeDetails>
                            <Employment>
                                <DirectorsNIC t-if="employee['is_director'] and not employee['ytd_basis']">AN</DirectorsNIC>
                                <DirectorsNIC t-if="employee['is_director'] and employee['ytd_basis']">AL</DirectorsNIC>
                                <TaxWkOfApptOfDirector t-if="employee['is_director'] and employee['appointed_week'] > 0"
                                                       t-out="employee['appointed_week']"/>
                                <PayId t-esc="employee['works_id']"/>
                                <LeavingDate  t-if="employee.get('leaving_date')" t-esc="employee['leaving_date']"/>
                                <FiguresToDate>
                                    <TaxablePay t-esc="'%.2f' % float(employee.get('taxable_pay_ytd','0.00'))"/>
                                    <TotalTax t-esc="'%.2f' % float(employee.get('total_tax_ytd','0.00'))"/>
                                    <StudentLoansTD t-if="float(employee.get('total_sl_ytd','0.00')) > 0"
                                                    t-esc="'%.2f' % float(employee.get('total_sl_ytd','0.00'))"/>
                                    <PostgradLoansTD t-if="float(employee.get('total_pl_ytd','0.00')) > 0"
                                                     t-esc="'%.2f' % float(employee.get('total_pl_ytd','0.00'))"/>
                                    <BenefitsTaxedViaPayrollYTD t-if="float(employee.get('payroll_benefits_ytd','0.00')) > 0"
                                                    t-esc="'%.2f' % float(employee.get('payroll_benefits_ytd','0.00'))"/>
                                    <EmpeePenContribnsPaidYTD t-if="float(employee.get('employee_pension_contributions_paid_ytd','0.00')) > 0"
                                                     t-esc="'%.2f' % float(employee.get('employee_pension_contributions_paid_ytd','0.00'))"/>
                                    <EmpeePenContribnsNotPaidYTD t-if="float(employee.get('employee_pension_contributions_not_paid_ytd','0.00')) > 0"
                                                     t-esc="'%.2f' % float(employee.get('employee_pension_contributions_not_paid_ytd','0.00'))"/>
                                </FiguresToDate>
                                <Payment>
                                    <PayFreq t-esc="employee['pay_frequency']"/>
                                    <PmtDate t-esc="employee['payment_date']"/>
                                    <LateReason t-if="employee['late_reason']"
                                                t-esc="employee['late_reason']"/>
                                    <WeekNo t-if="employee['pay_frequency'] == 'W1'"
                                            t-esc="employee['period_no']"/>
                                    <MonthNo t-if="employee['pay_frequency'] == 'M1'"
                                             t-esc="employee['period_no']"/>
                                    <PeriodsCovered t-esc="employee['periods_covered']"/>
                                    <HoursWorked t-if="employee.get('hours_worked')" t-out="employee.get('hours_worked')"/>
                                    <TaxCode
                                      t-esc="employee.get('tax_code','')"
                                      t-att-TaxRegime="employee.get('tax_regime') if employee.get('tax_regime') else None"
                                      t-att-BasisNonCumulative="employee.get('non_cumulative') if employee.get('non_cumulative') else None"
                                    />
                                    <TaxablePay t-esc="'%.2f' % float(employee.get('taxable_pay','0.00'))"/>
                                    <PayAfterStatDedns
                                            t-esc="'%.2f' % float(employee.get('pay_after_stat_deductions','0.00'))"/>
                                    <BenefitsTaxedViaPayroll t-if="float(employee.get('payroll_benefits','0.00')) > 0"
                                                    t-esc="'%.2f' % float(employee.get('payroll_benefits','0.00'))"/>
                                    <EmpeePenContribnsNotPaid t-if="float(employee.get('employee_pension_contributions_not_paid','0.00')) > 0"
                                            t-esc="'%.2f' % float(employee.get('employee_pension_contributions_not_paid','0.00'))"/>
                                    <EmpeePenContribnsPaid t-if="float(employee.get('employee_pension_contributions_paid','0.00')) > 0"
                                            t-esc="'%.2f' % float(employee.get('employee_pension_contributions_paid','0.00'))"/>
                                    <StudentLoanRecovered t-if="employee.get('has_student_loan')"
                                                          t-att-PlanType="employee.get('sl_plan')"
                                                          t-esc="'%.2f' % float(employee.get('sl_amt','0.00'))"/>
                                    <PostgradLoanRecovered t-if="employee.get('has_post_graduate_loan')"
                                                           t-esc="'%.2f' % float(employee.get('pl_amt','0.00'))"/>
                                    <TaxDeductedOrRefunded
                                            t-esc="'%.2f' % float(employee.get('tax_deducted_or_refunded','0.00'))"/>
                                </Payment>
                                <NIlettersAndValues>
                                    <NIletter t-esc="employee['ni_letter']"/>
                                    <GrossEarningsForNICsInPd
                                            t-esc="'%.2f' % float(employee.get('gross_earnings_for_nic_in_period','0.00'))"/>
                                    <GrossEarningsForNICsYTD t-esc="'%.2f' % float(employee.get('gross_earnings_for_nic_ytd','0.00'))"/>
                                    <AtLELYTD
                                            t-if="float(employee.get('gross_earnings_at_lel_ytd','0.00')) > 0"
                                            t-esc="'%.2f' % float(employee.get('gross_earnings_at_lel_ytd','0.00'))"/>
                                    <LELtoPTYTD
                                            t-esc="'%.2f' % float(employee.get('gross_earnings_lel_to_pt_ytd','0.00'))"/>
                                    <PTtoUELYTD
                                            t-esc="'%.2f' % float(employee.get('gross_earnings_pt_to_uel_ytd','0.00'))"/>
                                    <TotalEmpNICInPd
                                            t-esc="'%.2f' % float(employee.get('total_employer_nic_in_period','0.00'))"/>
                                    <TotalEmpNICYTD
                                            t-esc="'%.2f' % float(employee.get('total_employer_nic_ytd','0.00'))"/>
                                    <EmpeeContribnsInPd
                                            t-esc="'%.2f' % float(employee.get('employee_ni_contributions_in_period','0.00'))"/>
                                    <EmpeeContribnsYTD
                                            t-esc="'%.2f' % float(employee.get('employee_ni_contributions_ytd','0.00'))"/>
                                </NIlettersAndValues>
                            </Employment>
                        </Employee>
                    </t>
                    <FinalSubmission t-if="document.get('scheme_ceased_date','XXXX-XX-XX')">
                        <BecauseSchemeCeased>yes</BecauseSchemeCeased>
                        <DateSchemeCeased t-out="document.get('scheme_ceased_date','XXXX-XX-XX')"/>
                    </FinalSubmission>
                </FullPaymentSubmission>
            </IRenvelope>
        </Body>
    </template>
</odoo>
