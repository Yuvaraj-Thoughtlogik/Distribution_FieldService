#. module: l10n_uk_reports_paye
#: model:mail.template,body_html:l10n_uk_reports_paye.email_template_paye_response_success
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Dear <t t-out=\"object.sender_user_id.name\"/>,\n"
"                        <br/><br/>\n"
"                        Your PAYE return response for <t t-out=\"format_date(object.period_end)\"/> is now available on the Chatter section of your company page.\n"
"                        <br/><br/>\n"
"                        Please log in to review the details at your convenience.\n"
"                        <br/><br/>\n"
"                        Best regards,\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""

#. module: l10n_uk_reports_paye
#: model:mail.template,body_html:l10n_uk_reports_paye.email_template_paye_response_failure
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Dear <t t-out=\"object.sender_user_id.name\"/>,\n"
"                        <br/><br/>\n"
"                        Your PAYE return response for <t t-out=\"format_date(object.period_end)\"/> is now available on the Chatter section of your company page. Please note that an error was detected in the initial submission.\n"
"                        <br/><br/>\n"
"                        A new submission may be necessary to ensure compliance with HMRC requirements.\n"
"                        <br/><br/>\n"
"                        Best regards,\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""

#. module: l10n_uk_reports_paye
#: model:mail.template,body_html:l10n_uk_reports_paye.email_template_paye_response
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Dear <t t-out=\"object.user_id.name or ''\">Brandon Freeman</t>,\n"
"                        <br/><br/>\n"
"                        Your PAYE return response of <t t-out=\"format_date(object.period_end)\"/> is now available.\n"
"                        <br/><br/>\n"
"                        Odoo\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""

#. module: l10n_uk_reports_paye
#: model:mail.template,body_html:l10n_uk_reports_paye.email_template_paye_notification
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Dear <t t-out=\"partner_name or ''\">Brandon Freeman</t>,\n"
"                        <br/><br/>\n"
"                        We would like to remind you that your PAYE EPS return for the period ending <t t-out=\"period_end\"/> is due to be submitted to HMRC by <t t-out=\"period_due\"/>.\n"
"                        <br/><br/>\n"
"                        Please ensure that the report is sent on time to avoid any potential penalties.\n"
"                        <br/><br/>\n"
"                        Best regards,\n"
"                        <br/><br/>\n"
"                        Odoo\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""

