            <field name="amount_select">code</field>
            <field name="amount_python_compute">result_qty = 0
travel_hours = 0
worked_hours = 0
result = contract.hourly_wage

if 'TT' in inputs:
    result_qty += inputs['TT'].amount
    travel_hours += inputs['TT'].amount

if 'WORK105' in worked_days:
    result_qty += worked_days['WORK105'].number_of_hours
    travel_hours += worked_days['WORK105'].number_of_hours

if 'WORK100' in worked_days:
    worked_hours += worked_days['WORK100'].number_of_hours
    result_qty += worked_days['WORK100'].number_of_hours

if 'HOLPAY' in inputs:
    # leave is 9 hours, but we only count 8
    result_qty += inputs['HOLPAY'].amount // 8 * 8
    worked_hours += inputs['HOLPAY'].amount // 8 * 8

if 'STD' in inputs:
    result_qty += inputs['STD'].amount
    worked_hours += inputs['STD'].amount

if 'LEAVE100' in worked_days:
    # leave is 9 hours, but we only count 8
    worked_hours += worked_days['LEAVE100'].number_of_hours // 8 * 8
    result_qty += worked_days['LEAVE100'].number_of_hours // 8 * 8

if contract.standard_calendar_id.full_time_required_hours - worked_hours - travel_hours > 0:
    # result_qty -= (contract.standard_calendar_id.full_time_required_hours - worked_hours - travel_hours)
    result_qty = contract.standard_calendar_id.full_time_required_hours - worked_hours - travel_hours
else:
    result_qty = travel_hours</field>

