            <field name="sequence">100</field>
            <field name="code">NET</field>
            <field name="appears_on_employee_cost_dashboard">True</field>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
#direct_pension = result_rules['TPENE']['total'] if result_rules['TPENE']['total'] else 0.00
#result = round(categories['BASIC'] + categories['ALW'] - categories['DED'] - categories['PAYE'] - categories['NTD'] - categories['SS'] + categories['NTP'] - direct_pension,2)
result = round(categories['BASIC'] + categories['ALW'] + categories['SP'] + categories['NIO'] - categories['SS'] - categories['NTD']  + categories['NTP'] - categories['PAYE'] - categories['DED']  ,2)
        </field>
        <field name="struct_id" ref="hr_payroll.default_structure"/>
        </record>
