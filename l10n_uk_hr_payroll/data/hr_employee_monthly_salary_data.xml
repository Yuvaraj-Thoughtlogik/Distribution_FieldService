        <!-- Basic Pay: Re-define this from hr_payroll_data to change the computation-->
        <record id="default_basic_salary" model="hr.salary.rule">
            <field name="category_id" ref="hr_payroll.BASIC"/>
            <field name="name">Basic Salary</field>
            <field name="sequence">1</field>
            <field name="code">BASIC</field>
            <field name="appears_on_employee_cost_dashboard">True</field>
            <field name="condition_select">python</field>
            <field name="condition_python">result = payslip.paid_amount > 0 and 'WORK100' in worked_days</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">if contract.date_end:
  result_qty = 0
  result = ((((contract.wage * 12) / 52) / contract.resource_calendar_id.full_time_required_hours) ) #* contract.standard_calendar_id.hours_per_day) # daily rate
  if 'WORK100' in worked_days:
    result_qty += worked_days['WORK100'].number_of_hours
  if 'LEAVE110' in worked_days:
    result_qty += worked_days['LEAVE110'].number_of_hours
else:
    result = payslip.paid_amount</field>
            <field name="struct_id" ref="hr_payroll.default_structure"/>
        </record>
        <!-- Net Pay: Re-define this from hr_payroll_data to change the computation-->
        <record id="default_net_salary" model="hr.salary.rule">
            <field name="category_id" ref="hr_payroll.NET"/>
