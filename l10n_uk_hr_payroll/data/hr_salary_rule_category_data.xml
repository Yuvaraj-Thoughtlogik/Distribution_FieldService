<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="l10n_uk_hr_payroll.COMP" model="hr.salary.rule.category">
            <field name="name">Company Contribution</field>
            <field name="code">COMP</field>
        </record>
        <record id="l10n_uk_hr_payroll.PAYE" model="hr.salary.rule.category">
            <field name="name">PAYE</field>
            <field name="code">PAYE</field>
        </record>
        <record id="l10n_uk_hr_payroll.BIK" model="hr.salary.rule.category">
            <field name="name">Benefits in Kind</field>
            <field name="code">BIK</field>
        </record>
        <record id="l10n_uk_hr_payroll.NTD" model="hr.salary.rule.category">
            <field name="name">Non-Taxable Deduction</field>
            <field name="code">NTD</field>
        </record>
        <record id="l10n_uk_hr_payroll.NTP" model="hr.salary.rule.category">
            <field name="name">Non-Taxable Payment</field>
            <field name="code">NTP</field>
        </record>
        <record id="l10n_uk_hr_payroll.DIS" model="hr.salary.rule.category">
            <field name="name">Disclosure</field>
            <field name="code">DIS</field>
        </record>
        <!-- Employee Ownership Trusts's are not taxable up to £3,600 per year - but they are subject to NI
        and count towards student/postgrad loans and pension contributions
        NIO's are a payroll category where payments not subject to tax, but they are subject to NI-->
        <record id="l10n_uk_hr_payroll.NIO" model="hr.salary.rule.category">
            <field name="name">National Insurance Only</field>
            <field name="code">NIO</field>
        </record>
        <record id="l10n_uk_hr_payroll.SP" model="hr.salary.rule.category">
            <field name="name">Statutory Pay</field>
            <field name="code">SP</field>
            <!-- <field name="parent_id" ref="hr_payroll.ALW"/> -->
        </record>

    </data>
</odoo>
