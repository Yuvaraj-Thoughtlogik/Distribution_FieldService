<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="l10n_uk_hr_payroll.hr_payroll_resource_calendar_std" model="resource.calendar">
            <field name="full_time_required_hours">40</field>
            <field name="name">Standard 40 hours/week</field>
        </record>

        <record id="uk_salary_journal" model="account.journal">
            <field name="name">UK Salaries</field>
            <field name="code">SAL</field>
            <field name="type">general</field>
            <field name="sequence">99</field>
        </record>

        <!-- Payroll Salary Structures -->
        <!--
           We want to define two payroll structures:
               - Monthly Salaried Employee - fixed wages
               - Weekly Wage Employee - weekly wages

           These can be customised to adapted as needed.
       -->
        <record id='uk_hr_payroll_employee_structure' model='hr.payroll.structure'>
            <field name="name">UK: Salaried Employee</field>
            <field name="type_id" ref="hr_contract.structure_type_employee"/>
            <field name="schedule_pay">monthly</field>
            <field name="unpaid_work_entry_type_ids"
                   eval="[(4, ref('hr_work_entry_contract.work_entry_type_unpaid_leave'))]"/>
            <field name="ytd_computation">True</field>
            <field name="country_id" ref="base.uk"/>
            <field name="journal_id" ref="uk_salary_journal"/>
            <field name="report_id" ref="l10n_uk_hr_payroll.action_report_payslip_uk"/>
        </record>
        <record id="uk_hr_payroll_worker_structure" model="hr.payroll.structure">
            <field name="name">UK: Hourly Employee</field>
            <field name="type_id" ref="hr_contract.structure_type_worker"/>
            <field name="schedule_pay">weekly</field>
            <field name="unpaid_work_entry_type_ids"
                   eval="[(4, ref('hr_work_entry_contract.work_entry_type_unpaid_leave'))]"/>
            <field name="ytd_computation">True</field>
            <field name="country_id" ref="base.uk"/>
            <field name="journal_id" ref="uk_salary_journal"/>
            <field name="report_id" ref="l10n_uk_hr_payroll.action_report_payslip_uk"/>
        </record>
    </data>
</odoo>
