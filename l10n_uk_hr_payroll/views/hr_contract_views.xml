<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_contract_view_form" model="ir.ui.view">
        <field name="name">hr.contract.form</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_payroll.hr_contract_form_inherit"/>
        <field name="arch" type="xml">
            <group name="salary_info" position="inside">
                <group name="pension" string="Pension" invisible="country_code != 'GB'"
                    groups="hr_payroll.group_hr_payroll_user">
                    <label for="is_autoenrolment" invisible="country_code != 'GB'"/>
                    <div class="o_row" invisible="country_code != 'GB'">
                        <field name="is_autoenrolment" class="oe_inline" widget="binaryContractFile"/>
                    </div>
                    <label for="pension_fund" invisible="country_code != 'GB' or not is_autoenrolment"/>
                    <div class="o_row" invisible="country_code != 'GB' or not is_autoenrolment">
                        <field name="pension_fund" class="o_hr_wide_field" nolabel="1"/>
                    </div>
                    <label for="member_no" invisible="country_code != 'GB' or not is_autoenrolment"/>
                    <div class="o_row" invisible="country_code != 'GB' or not is_autoenrolment">
                        <field name="member_no" class="o_hr_narrow_field" nolabel="1"/>
                        <span class="ms-3"></span>
                    </div>
                    <label for="employee_pension_contribution"
                           invisible="country_code != 'GB' or not is_autoenrolment"/>
                    <div class="o_row" invisible="country_code != 'GB' or not is_autoenrolment">
                        <field name="employee_pension_contribution" class="o_hr_narrow_field" nolabel="1"/>
                        <span class="ms-3">%</span>
                    </div>
                    <label for="employer_pension_contribution"
                           invisible="country_code != 'GB' or not is_autoenrolment"/>
                    <div class="o_row" invisible="country_code != 'GB' or not is_autoenrolment">
                        <field name="employer_pension_contribution" class="o_hr_narrow_field" nolabel="1"/>
                        <span class="ms-3">%</span>
                    </div>
                    <label for="employer_pension_contribution_amount"
                           invisible="country_code != 'GB' or not is_autoenrolment"/>
                    <div class="o_row" invisible="country_code != 'GB' or not is_autoenrolment">
                        <field name="employer_pension_contribution_amount" class="o_hr_narrow_field" nolabel="1"/>
                        <span class="ms-3">%</span>
                    </div>
                    <label for="pension_exceed_max" invisible="country_code != 'GB' or not is_autoenrolment"/>
                    <div class="o_row" invisible="country_code != 'GB' or not is_autoenrolment">
                        <field name="pension_exceed_max" class="o_inline" widget="binaryContractFile"/>
                    </div>
                    <label for="ae_status" invisible="country_code != 'GB' or not is_autoenrolment"/>
                    <div class="o_row" invisible="country_code != 'GB' or not is_autoenrolment">
                        <field name="ae_status" class="o_hr_narrow_field" nolabel="1"/>
                    </div>
                    <label for="ae_group" invisible="country_code != 'GB' or not is_autoenrolment"/>
                    <div class="o_row" invisible="country_code != 'GB' or not is_autoenrolment">
                        <field name="ae_group" class="o_hr_narrow_field" nolabel="1"/>
                    </div>
                    <label for="ae_date" invisible="country_code != 'GB' or not is_autoenrolment"/>
                    <div class="o_row" invisible="country_code != 'GB' or not is_autoenrolment">
                        <field name="ae_date" class="o_hr_narrow_field" nolabel="1"/>
                    </div>
                    <label for="next_autoenrolment_date" invisible="country_code != 'GB' or not is_autoenrolment"/>
                    <div class="o_row" invisible="country_code != 'GB' or not is_autoenrolment">
                        <field name="next_autoenrolment_date" class="o_hr_narrow_field" nolabel="1"/>
                    </div>

                </group>
                <group name="director" string="Director" invisible="country_code != 'GB'"
                    groups="hr_payroll.group_hr_payroll_user">
                    <label for="is_director" invisible="country_code != 'GB'"/>
                    <div class="o_row" invisible="country_code != 'GB'">
                        <field name="is_director" class="oe_inline" widget="binaryContractFile"/>
                    </div>

                    <label for="is_ytd_basis" invisible="country_code != 'GB' or not is_director"/>
                    <div class="o_row" invisible="country_code != 'GB' or not is_director">
                        <field name="is_ytd_basis" class="oe_inline" widget="binaryContractFile"/>
                    </div>
                    <label for="director_date" invisible="country_code != 'GB' or not is_director"/>
                    <div class="o_row" invisible="country_code != 'GB' or not is_director">
                        <field name="director_date" class="oe_inline" widget="daterange"/>
                    </div>
                </group>
            </group>
        </field>
    </record>
</odoo>
