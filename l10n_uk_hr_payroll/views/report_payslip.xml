<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_payslip_uk">
        <t t-call="web.external_layout">
            <div class="page">
                <h2 id="payslip_name">
                    <span t-field="o.name">April 2024 Payslip</span>
                </h2>
                <t t-set="is_invalid" t-value="o._is_invalid()"/>
                <div t-if="is_invalid">
                    <strong id="invalid_warning">
                        <span t-out="is_invalid">This payslip is not validated. This is not a legal document.</span>
                    </strong>
                </div>
                <div t-else="">
                    <div class="oe_structure"/>
                </div>
                <div id="infos_table">
                    <table class="table table-sm table-borderless">
                        <thead class="o_black_border">
                            <tr>
                                <th>Employee Information</th>
                                <th>Other Information</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td id="employee_infos">
                                    <div id="employee_name">
                                        <strong class="me-2">Name:</strong>
                                        <span t-field="o.employee_id.name"/>
                                    </div>
                                    <div id="employee_id">
                                        <strong class="me-2">National Insurance No.:</strong>
                                        <span t-if="o.employee_id.l10n_uk_ni_code "
                                              t-field="o.employee_id.l10n_uk_ni_code"/>
                                        <span t-else="" style="color:#875A7B" class="fw-bold">No National Insurance
                                            number on the employee !!!
                                        </span>
                                    </div>
                                    <!--
                                    <div id="employee_tax_letter" t-if="o.employee_id.l10n_uk_ni_letter">
                                    <strong class="me-2">Tax Letter:</strong>
                                    <span t-field="o.employee_id.l10n_uk_ni_letter"/>
                                    </div>
                                    -->
                                    <div id="employee_tax_code" t-if="o.employee_id.l10n_uk_tax_code">
                                        <strong class="me-2">Tax Code:</strong>
                                        <span t-field="o.employee_id.l10n_uk_tax_code"/>
                                    </div>
                                    <div id="employee_email" t-if="o.employee_id.private_email">
                                        <strong class="me-2">Email:</strong>
                                        <span t-field="o.employee_id.private_email"/>
                                    </div>
                                    <!--
                                    <div id="employee_email" t-if="o.employee_id.work_email">
                                    <strong class="me-2">Email:</strong>
                                    <span t-field="o.employee_id.work_email"/>
                                    </div>
                                    -->
                                    <div id="employee_job_title" t-if="o.employee_id.job_title">
                                        <strong class="me-2">Job Position:</strong>
                                        <span t-field="o.employee_id.job_title"/>
                                    </div>
                                    <div id="employee_department" t-if="o.employee_id.department_id">
                                        <strong class="me-2">Department:</strong>
                                        <span t-field="o.employee_id.department_id"/>
                                    </div>
                                    <div id="employee_isDirector" t-if="o.contract_id.is_director">
                                        <strong class="me-2">Director:</strong>
                                        <span>Yes</span>
                                    </div>
                                    <div id="employee_is_autoenroled" t-if="o.contract_id.is_autoenrolment">
                                        <strong class="me-2">Pension Enrolment:</strong>
                                        <span t-field="o.contract_id.pension_fund"/>
                                    </div>
                                    <div id="employee_has_student_loan" t-if="o.employee_id.has_student_loan">
                                        <strong class="me-2">Student Loan:</strong>
                                        <span t-field="o.employee_id.student_loan_plan"/>
                                    </div>
                                    <div id="employee_has_post_graduate_loan"
                                         t-if="o.employee_id.has_post_graduate_loan">
                                        <strong class="me-2">Post-Graduate Loan:</strong>
                                        <span t-field="o.employee_id.has_post_graduate_loan"/>
                                    </div>
                                    <!--
                                    <div id="employee_marital">
                                    <strong class="me-2">Marital Status:</strong>
                                    <span t-field="o.employee_id.marital"/>
                                    </div>

                                    <div id="employee_person_in_charge" t-if="o.employee_id.children">
                                    <strong class="me-2">Children:</strong>
                                    <span t-field="o.employee_id.children"/>
                                    </div>
                                    -->
                                    <div id="employee_private_address"
                                         t-if="o.employee_id.private_street and o.employee_id.private_city">
                                        <strong class="me-2">Private Address:</strong>
                                        <span t-field="o.employee_id.private_street"/>,
                                        <span t-field="o.employee_id.private_street2"
                                              t-if="o.employee_id.private_street2" class="ms-2"/>
                                        <span t-if="o.employee_id.private_street2">,</span>
                                        <span t-field="o.employee_id.private_city" class="ms-2"/>
                                        <span t-field="o.employee_id.private_zip"/>
                                        <span t-field="o.employee_id.private_country_id"/>
                                    </div>
                                </td>
                                <td id="other_infos">
                                    <div id="wage">
                                        <strong class="me-2">Contract Wage (<span class="text-capitalize"
                                                                                  t-out="o.contract_id.wage_type"/>):
                                        </strong>
                                        <span t-out="o.contract_id._get_contract_wage()"
                                              t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"
                                              style="color:#875A7B" class="fw-bold"/>
                                    </div>
                                    <div id="pay_period">
                                        <strong class="me-2">Pay Period:</strong>
                                        <span t-if="o.date_from &lt; o.contract_id.date_start"
                                              t-field="o.contract_id.date_start"/>
                                        <span t-else="" t-field="o.date_from"/>
                                        -
                                        <span t-if="o.contract_id.date_end and o.date_to &gt; o.contract_id.date_end"
                                              t-field="o.contract_id.date_end"/>
                                        <span t-else="" t-field="o.date_to"/>
                                    </div>
                                    <div id="computed_on">
                                        <strong class="me-2">Computed On:</strong>
                                        <span t-field="o.compute_date"/>
                                    </div>
                                    <div id="contract_start">
                                        <strong class="me-2">Contract Start Date:</strong>
                                        <span t-field="o.employee_id.first_contract_date"/>
                                    </div>
                                    <div id="contract_type" t-if="o.contract_id.contract_type_id">
                                        <strong class="me-2">Contract Type:</strong>
                                        <span t-field="o.employee_id.contract_id.contract_type_id"/>
                                    </div>
                                    <div id="working_schedule">
                                        <strong class="me-2">Working Schedule:</strong>
                                        <span t-field="o.employee_id.contract_id.hours_per_week"/>
                                        Hours / Week
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <!--
