<odoo>
    <record id="l10n_uk_hr_payroll.action_report_p60" model="ir.actions.report">
        <field name="name">P60</field>
        <field name="model">hr.employee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_uk_hr_payroll.report_p60_lang</field>
        <field name="report_file">l10n_uk_hr_payroll.report_p60_lang</field>
        <field name="print_report_name">'P60 - %s' % (object.name)</field>
        <field name="paperformat_id" ref="l10n_uk_hr_payroll.paperformat_uk_full_page"/>
        <field name="binding_model_id" ref="model_hr_employee"/>
        <field name="binding_type">report</field>
        <!-- Erase fields to avoid double PDF posting -->
        <field name="attachment"/>
        <field name="attachment_use" eval="False"/>
    </record>
    <record id="action_report_payslip_uk" model="ir.actions.report">
        <field name="name">UK: Payslip</field>
        <field name="model">hr.payslip</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_uk_hr_payroll.report_payslip_uk_lang</field>
        <field name="report_file">l10n_uk_hr_payroll.report_payslip_uk_lang</field>
        <field name="print_report_name">'Payslip - %s' % (object.employee_id.name)</field>
        <field name="paperformat_id" ref="l10n_uk_hr_payroll.paperformat_uk_full_page"/>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_type">report</field>
        <!-- Erase fields to avoid double PDF posting -->
        <field name="attachment"/>
        <field name="attachment_use" eval="False"/>
    </record>
</odoo>