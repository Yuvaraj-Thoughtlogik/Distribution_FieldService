<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_p60_header">
        <h2>End of Year Certificate - Tax year to 5 April <span t-out="d['year']"/></h2>
        <p>This is a printed copy of an eP60</p>
    </template>
    <template id="report_p60_footer">
        <div class="din_page">
            <table class="table">
                <tr>
                    <td>P60(Substitute)</td>
                    <td>
                        <strong>Do not destroy</strong>
                    </td>
                    <td class="text-end">HMRC 12/22</td>
                </tr>
            </table>
        </div>
    </template>
    <template id="report_p60_body">
        <!-- https://assets.publishing.service.gov.uk/media/6756bf0e7ec19a3516f799ff/RD1_P60_24-25.pdf -->
        <!--
        <t t-set="custom_header" t-value="'l10n_uk_hr_payroll.report_p60_header'"/>
        <t t-set="custom_footer" t-value="'l10n_uk_hr_payroll.report_p60_footer'"/>
        -->
        <t t-call="web.basic_layout">
            <t t-set="d" t-value="o._uk_p60_data()"/>
            <t t-set="title" t-value="P60"/>
            <!-- Insert Header -->
            <h2>End of Year Certificate - Tax year to 5 April
                <span t-out="d['year']"/>
            </h2>
            <p>This is a printed copy of an eP60</p>
            <!-- End of Header -->

            <div class="page oe_structure oe_empty">
                <h5 class="text-decoration-underline" style="color:#875A7B;">Employee Information</h5>
                <table name="employee-infos" class="table table-bordered">
                    <tr id="employee_info_line_1">
                        <td class="w-25">
                            <strong>Forename</strong>
                        </td>
                        <td class="w-25">
                            <strong>Surname</strong>
                        </td>
                        <td class="w-25">
                            <strong>Payroll Number</strong>
                        </td>
                        <td class="w-25">
                            <strong>NI Number</strong>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <span t-out="o.l10n_uk_forename"/>
                        </td>
                        <td>
                            <span t-out="o.l10n_uk_surname"/>
                        </td>
                        <td>
                            <span t-out="o.registration_number"/>
                        </td>
                        <td>
                            <span t-out="o.l10n_uk_ni_code"/>
                        </td>
                    </tr>
                </table>
                <h5 class="text-decoration-underline" style="color:#875A7B;">Pay and Income Tax details</h5>
                <table name="income_tax" class="table table-bordered">
                    <tr id="employee_info_line_1">
                        <td class="w-50"></td>
                        <td class="w-25 text-end">
                            <strong>Pay</strong>
                        </td>
                        <td class="w-25 text-end">
                            <strong>Tax Deducted</strong>
                        </td>
                    </tr>
                    <t t-foreach="d['income_lines']" t-as="line">
                        <tr>
                            <td>
                                <span t-out="line['name']"/>
                            </td>
                            <td class="text-end">
                                <span t-esc="round(line['pay'],2)" t-options="{'widget': 'float', 'precision': 2}"/>
                            </td>
                            <td class="text-end">
                                <span t-esc="round(line['tax'],2)" t-options="{'widget': 'float', 'precision': 2}"/>
                            </td>
                        </tr>
                    </t>
                    <tfoot>
                        <tr>
                            <td>Final tax code</td>
                            <td class="text-end">
                                <span t-out="o.l10n_uk_tax_code"/>
                            </td>
                        </tr>
                    </tfoot>
                </table>
                <h5 class="text-decoration-underline" style="color:#875A7B;">National Insurance contributions in this
                    employment
                </h5>
                <table name="nic" class="table table-bordered">
                    <tr id="employee_info_line_1">
                        <td class="w-10 text-center">
                            <strong>NIC Letter</strong>
                        </td>
                        <td class="w-20 text-center">
                            <strong>Earning at the Lower Earning Limit (LEL)</strong>
                        </td>
                        <td class="w-20 text-center">
                            <strong>Earnings above the LEL, up to and including the Primary Threshold (PT)</strong>
                        </td>
                        <td class="w-20 text-center">
                            <strong>Earnings above the PT, up to and including the Upper Earnings Limit (UEL)</strong>
                        </td>
                        <td class="w-20 text-center">
                            <strong>Employee’s contributions due on all earnings above the PT</strong>
                        </td>
                    </tr>
                    <t t-foreach="d['nic_lines']" t-as="line">
                        <tr>
                            <td>
                                <span t-out="line['letter']"/>
                            </td>
                            <td class="text-end">
                                <span t-esc="line['lel']" t-options="{'widget': 'float', 'precision': 2}"/>
                            </td>
                            <td class="text-end">
                                <span t-esc="line['pt']" t-options="{'widget': 'float', 'precision': 2}"/>
                            </td>
                            <td class="text-end">
                                <span t-esc="line['uel']" t-options="{'widget': 'float', 'precision': 2}"/>
                            </td>
                            <td class="text-end">
                                <span t-esc="line['contrib']" t-options="{'widget': 'float', 'precision': 2}"/>
                            </td>
                        </tr>
                    </t>
                </table>
                <h5 class="text-decoration-underline" style="color:#875A7B;">Statutory Pay</h5>
                <table name="statutory_pay" class="table table-bordered">
                    <tr id="employee_info_line_1">
                        <td class="w-10 text-center">
                            <strong>Statutory Maternity Pay</strong>
                        </td>
                        <td class="w-20 text-center">
                            <strong>Statutory Paternity Pay</strong>
                        </td>
                        <td class="w-20 text-center">
                            <strong>Statutory Shared Parental Pay</strong>
                        </td>
                        <td class="w-20 text-center">
                            <strong>Statutory Adoption Pay</strong>
                        </td>
                        <td class="w-20 text-center">
                            <strong>Statutory Parental Bereavement Pay</strong>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-end">
                            <span t-esc="d['smp']" t-options="{'widget': 'float', 'precision': 2}"/>
                        </td>
                        <td class="text-end">
                            <span t-esc="d['spp']" t-options="{'widget': 'float', 'precision': 2}"/>
                        </td>
                        <td class="text-end">
                            <span t-esc="d['sspp']" t-options="{'widget': 'float', 'precision': 2}"/>
                        </td>
                        <td class="text-end">
                            <span t-esc="d['sap']" t-options="{'widget': 'float', 'precision': 2}"/>
                        </td>
                        <td class="text-end">
                            <span t-esc="d['spbp']" t-options="{'widget': 'float', 'precision': 2}"/>
                        </td>
                    </tr>
                </table>
                <h5 class="text-decoration-underline" style="color:#875A7B;">Student Loan</h5>
                <table name="student_loan" class="table table-bordered">
                    <tr id="employee_info_line_1">
                        <td class="text-end">
                            <strong>Student Loan Deduction</strong>
                        </td>
                        <td class="text-end">
                            <strong>Postgraduate Loan Deduction</strong>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-end">
                            <span t-esc="d['st_loan']" t-options="{'widget': 'float', 'precision': 2}"/>
                        </td>
                        <td class="text-end">
                            <span t-esc="d['pg_loan']" t-options="{'widget': 'float', 'precision': 2}"/>
                        </td>
                    </tr>
                </table>
                <h5 class="text-decoration-underline" style="color:#875A7B;">Employer Info</h5>
                <table name="employer" class="table table-bordered">
                    <tr id="employer_paye">
                        <td>
                            <strong>Employer PAYE:</strong>
                        </td>
                        <td>
                            <span t-out="d['employer_paye']"/>
                        </td>
                    </tr>
                    <tr id="employer_info">
                        <td colspan="2">
                            <span t-out="d['employer_desc']"/>
                        </td>
                    </tr>
                </table>
            </div>

            <!-- Insert Footer -->
            <div class="din_page">
                <table class="table">
                    <tr>
                        <td>P60(Substitute)</td>
                        <td>
                            <strong>Do not destroy</strong>
                        </td>
                        <td class="text-end">HMRC 12/22</td>
                    </tr>
                </table>
            </div>
        </t>
    </template>
    <template id="report_p60_lang">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <!--<t t-set="o" t-value="o.with_context(lang=o.env.lang)"/>
                <t t-call="report_p60" t-lang="o.env.lang"/>
                <t t-call="report_p60_body"/> -->
                <t t-call="l10n_uk_hr_payroll.report_p60_body" t-lang="o.env.lang"/>
            </t>
        </t>
    </template>
</odoo>
