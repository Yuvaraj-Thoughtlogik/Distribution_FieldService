<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_uk_pension_fund_view_form" model="ir.ui.view">
        <field name="name">l10n_uk_pension_fund_view_form</field>
        <field name="model">l10n_uk_pension_fund</field>
        <field name="arch" type="xml">
            <form string="Pension Fund Maintenance">
                <header>
                    <h1>Pension Fund Maintenance</h1>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name" placeholder="Pension Fund"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <label for="name"/>
                            <div class="o_row">
                                <field name="name" class="o_hr_wide_field" nolabel="1"/>
                            </div>

                            <label for="pension_street"/>
                            <div class="o_row">
                                <field name="pension_street" class="o_hr_wide_field" nolabel="1"/>
                            </div>

                            <label for="pension_street2"/>
                            <div class="o_row">
                                <field name="pension_street2" class="o_hr_wide_field" nolabel="1"/>
                            </div>

                            <label for="pension_city"/>
                            <div class="o_row">
                                <field name="pension_city" class="o_hr_wide_field" nolabel="1"/>
                            </div>

                            <label for="pension_state_id"/>
                            <div class="o_row">
                                <field name="pension_state_id" class="o_hr_wide_field" nolabel="1"/>
                            </div>

                            <label for="pension_zip"/>
                            <div class="o_row">
                                <field name="pension_zip" class="o_hr_narrow_field" nolabel="1"/>
                            </div>

                            <label for="pension_country_id"/>
                            <div class="o_row">
                                <field name="pension_country_id" class="o_hr_wide_field" nolabel="1"/>
                            </div>

                        </group>
                        <group>
                            <label for="pension_email"/>
                            <div class="o_row">
                                <field name="pension_email" class="o_hr_wide_field" nolabel="1"/>
                            </div>

                            <label for="pension_phone"/>
                            <div class="o_row">
                                <field name="pension_phone" class="o_hr_wide_field" nolabel="1"/>
                            </div>

                            <label for="fund_type"/>
                            <div class="o_row">
                                <field name="fund_type" class="o_hr_wide_field" nolabel="1"/>
                            </div>
                            <!--
                            <label for="employer_ref"/>
                            <div class="o_row">
                                <field name="employer_ref" class="o_hr_wide_field" nolabel="1"/>
                            </div>
                            <label for="payment_source"/>
                            <div class="o_row">
                                <field name="payment_source" class="o_hr_nwide_field" nolabel="1"/>
                            </div>
                            -->
                        </group>
                        <notebook>
                            <page id="company_tab" name="company_tab" string="Company">
                                <field name="company_ids" options="{'no_create': True}"
                                       context="{'allowed_company_ids': allowed_company_ids}"
                                       invisible="not context.get('is_hr_payroll', True)"
                                       required="context.get('is_hr_payroll')">
                                    <list editable="bottom" string="Pension Fund for a Company" default_order="company_id asc">
                                        <field name="company_id" required="True"/>
                                        <field name="employer_ref" optional="show"/>
                                        <field name="payment_source" optional="show"/>
                                        <field name="banded_earnings" widget="boolean_toggle"/>
                                        <field name="include_allowances" widget="boolean_toggle"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="l10n_uk_pension_fund_view_list" model="ir.ui.view">
        <field name="name">l10n_uk_pension_fund_view_list</field>
        <field name="model">l10n_uk_pension_fund</field>
        <field name="arch" type="xml">
            <list string="Pension Funds" open_form_view="True" default_order="name asc">
                <field name="name" string="Pension Name"/>
                <field name="fund_type" string="Pension Type"/>
            </list>
        </field>
    </record>
</odoo>