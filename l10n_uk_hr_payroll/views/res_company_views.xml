<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_company_form" model="ir.ui.view">
        <field name="name">l10n.uk.payroll.res.company.form</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='branches']" position="after">
                <page string="Payroll" name="payroll" invisible="country_code != 'GB'"
                      groups="account.group_account_manager">

                    <!--            <xpath expr="//page[@name='hmrc']" position="inside"> -->
                    <group string="Employer Details">
                        <field name="l10n_uk_hmrc_is_employer" string="Is this company a PAYE Employer?"
                               groups="account.group_account_manager"/>
                    </group>
                    <group invisible="not l10n_uk_hmrc_is_employer">
                        <field name="l10n_uk_hmrc_paye_ref" string="PAYE Ref" groups="account.group_account_manager"/>
                        <field name="l10n_uk_hmrc_small_employer" string="Small Employers Relief"
                               groups="account.group_account_manager"/>
                        <field name="l10n_uk_hmrc_employment_allowance" string="Claim Employment Allowance"
                               groups="account.group_account_manager"/>
                        <field name="l10n_uk_hmrc_employment_allowance_ytd" string="Employment Allowance claimed YTD"
                               groups="account.group_account_manager"
                               invisible="not l10n_uk_hmrc_employment_allowance"/>
                        <field name="l10n_uk_hmrc_paye_ceased" string="Date scheme ceased"
                               groups="account.group_account_manager"/>
                        <field name="l10n_uk_employees" string="Employees" readonly="1"
                               groups="account.group_account_manager"/>
                        <!--<field name="l10n_uk_pensionable_earnings" string="Pensionable Earnings Basis"
                               groups="account.group_account_manager"/>
                               -->
                    </group>
                    <!--<group string="Pension Details">
                        <field name="l10n_uk_pension_employer_reference" string="Employer Reference"
                            groups="account.group_account_manager"/>
                        <field name="l10n_uk_pension_payment_source" string="Employer Reference"
                            groups="account.group_account_manager"/>
                    </group>
                    -->
                </page>
            </xpath>
        </field>
    </record>
</odoo>