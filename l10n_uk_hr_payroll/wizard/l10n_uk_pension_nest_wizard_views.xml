<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_uk_pension_nest_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n_uk_pension_nest_wizard.view.form</field>
        <field name="model">l10n_uk_pension_nest_wizard</field>
        <field name="arch" type="xml">
            <form string="Pension Report: Nest Export" create="True" edit="True" delete="True">
                <sheet>
                    <group>
                        <div>
                            <div class="o_row">
                                <span class="oe_inline">Batch</span>
                                <field name="run_id" class="oe_inline o_hr_narrow_field" nolabel="1"/>
                            </div>
                            <!--
                            <div class="o_row" visible="not run_id">
                                <span class="oe_inline">From</span>
                                <field name="date_from" class="oe_inline o_hr_narrow_field" nolabel="1"/>
                                <span class="oe_inline">To</span>
                                <field name="date_to" class="oe_inline o_hr_narrow_field" nolabel="1"/>
                            </div>
                            -->
                        </div>
                        <separator string="Employees"/>
                        <field name="employee_ids" nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Export CSV" name="action_export_csv" type="object" class="btn-primary"/>
                    <button special="cancel" string="Close" type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="l10n_uk_pension_nest_wizard_action" model="ir.actions.act_window">
        <field name="name">NEST Pension Report Export</field>
        <field name="res_model">l10n_uk_pension_nest_wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!--  Add the UK Payroll Reports -->
    <!--
    <menuitem
        id="menu_reporting_l10n_uk"
        name="UK"
        sequence="30"
        parent="hr_payroll.menu_hr_payroll_report"/>
-->
    <menuitem
            id="menu_l10n_uk_pension_nest_wizard"
            name="NEST Pension Report"
            action="l10n_uk_pension_nest_wizard_action"
            parent="l10n_uk_hr_payroll.menu_reporting_l10n_uk"
            sequence="22"
    />
</odoo>
