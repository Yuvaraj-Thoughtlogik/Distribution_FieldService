<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_uk_pension_royal_london_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n_uk_pension_royal_london_wizard.view.form</field>
        <field name="model">l10n_uk_pension_royal_london_wizard</field>
        <field name="arch" type="xml">
            <form string="Pension Report: Royal London Pension Export" create="True" edit="True" delete="True">
                <sheet>
                    <group>
                        <div>
                            <div class="o_row">
                                <label for="run_id"/>
                                <field name="run_id"/>
                            </div>
                        </div>
                        <separator string="Employees"/>
                        <field name="employee_ids" nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Export CSV" name="action_export_csv" type="object" class="btn-primary"/>
                    <button special="cancel" string="Close" type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="l10n_uk_pension_royal_london_wizard_action" model="ir.actions.act_window">
        <field name="name">Royal London Pension Report Export</field>
        <field name="res_model">l10n_uk_pension_royal_london_wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
            id="menu_l10n_uk_pension_royal_london_wizard"
            name="Royal London Pension Report"
            action="l10n_uk_pension_royal_london_wizard_action"
            parent="l10n_uk_hr_payroll.menu_reporting_l10n_uk"
            sequence="22"
    />
</odoo>
