        <field name="view_mode">list,form</field>
    </record>
    <!-- This Menu Item Must have a parent -->
    <menuitem id="calendar_type_of_action_action_categ" name="Types of Visit" parent="calendar.calendar_menu_config" action="calendar_type_of_action_action" sequence="40"/>
