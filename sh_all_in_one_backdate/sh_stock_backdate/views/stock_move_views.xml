<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="stock_move_inherit_view_form_stock" model="ir.ui.view">
        <field name="name">stock.move.inherit.view.form</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_form"/>
        <field name="arch" type="xml">
            <group name="main_grp_col1" position="inside">
                <field name="remarks_for_picking" invisible="not is_remarks_for_picking or not remarks_for_picking"/>
                <field name="is_remarks_for_picking" invisible="1"/>

                <field name="remarks_for_scrap" invisible="not is_remarks_for_scrap or not remarks_for_scrap"/>
                <field name="is_remarks_for_scrap" invisible="1"/>
            </group>
        </field>
    </record>

    <!-- Odoo 20: stock.scrap was replaced by scrap stock moves -->
    <record id="stock_scrap_move_inherit_view_form" model="ir.ui.view">
        <field name="name">stock.scrap.move.inherit.view.form</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_scrap_move_form"/>
        <field name="arch" type="xml">
            <field name="scrap_reason_tag_ids" position="after">
                <field name="sh_scrap_date" readonly="state in ('done', 'cancel')"/>
                <field name="remarks_for_scrap" invisible="not is_remarks_for_scrap"
                       required="is_remarks_mandatory_for_scrap and is_scrap_backdated"/>
                <field name="is_remarks_for_scrap" invisible="1"/>
                <field name="is_remarks_mandatory_for_scrap" invisible="1"/>
                <field name="is_scrap_backdated" invisible="1"/>
            </field>
        </field>
    </record>
</odoo>
